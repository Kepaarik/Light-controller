<Project>

  <!-- Общие настройки всех проектов Light Space -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- В релизе отладочная информация встроена в сборку: рядом с exe нет .pdb, а в журнале ошибок есть номера строк -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
