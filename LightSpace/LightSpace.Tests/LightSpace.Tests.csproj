<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты миграций конфига, кодирования команд устройств, моделей окна и загрузки разметки -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Модели и страницы окна — WPF -->
    <UseWPF>true</UseWPF>
    <RootNamespace>LightSpace.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- С UseWPF System.IO пропадает из общих using: у WPF свой Path -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightSpace.Core\LightSpace.Core.csproj" />
    <ProjectReference Include="..\LightSpace.Devices\LightSpace.Devices.csproj" />
    <ProjectReference Include="..\LightSpace.Engine\LightSpace.Engine.csproj" />
    <ProjectReference Include="..\LightSpace.App\LightSpace.App.csproj" />
  </ItemGroup>

</Project>
