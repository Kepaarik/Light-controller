<!-- Кнопки: обычная, Accent, Ghost, Danger, кнопка-значок, пункт меню, кнопки окна -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LightSpace.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightSpace;component/Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Общий шаблон всех кнопок: поверх фона лежит слой состояния, его цвет под курсором и при нажатии берётся
         из Appearance.HoverBrush и Appearance.PressedBrush, а сам слой плавно проявляется и гаснет.
         Значок слева от подписи — из Appearance.Icon -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{Binding (controls:Appearance.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="StateLayer" Opacity="0" IsHitTestVisible="False"
                        CornerRadius="{Binding (controls:Appearance.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{Binding (controls:Appearance.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Grid Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IconGlyph"
                               Text="{Binding (controls:Appearance.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                               FontFamily="{StaticResource FontIcon}" FontSize="{StaticResource FontSizeIcon}"
                               VerticalAlignment="Center" Margin="{StaticResource GapRight8}"/>
                    <ContentPresenter x:Name="Content" Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="controls:Appearance.Icon" Value="{x:Null}">
                <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="IconGlyph" Property="Margin" Value="{StaticResource SpaceNone}"/>
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <!-- Слой проявляется быстро и гаснет чуть медленнее; погасший слой отдаёт прозрачность обратно триггерам ниже -->
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StateLayer" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StateLayer" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource MotionNormal}" EasingFunction="{StaticResource EaseOut}"
                                             FillBehavior="Stop"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="controls:Appearance.ForceHover" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="1"/>
                <Setter TargetName="StateLayer" Property="Background"
                        Value="{Binding (controls:Appearance.PressedBrush), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="Content" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="controls:Appearance.ForcePressed" Value="True">
                <Setter TargetName="StateLayer" Property="Opacity" Value="1"/>
                <Setter TargetName="StateLayer" Property="Background"
                        Value="{Binding (controls:Appearance.PressedBrush), RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter TargetName="Content" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Обычная кнопка: полупрозрачная заливка и тонкая обводка -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource StateHoverBrush}"/>
        <Setter Property="controls:Appearance.PressedBrush" Value="{DynamicResource StatePressedBrush}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

    <!-- Главное действие: заливка системным акцентным цветом и мягкое свечение акцентом вокруг -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource AccentStateHoverBrush}"/>
        <Setter Property="controls:Appearance.PressedBrush" Value="{DynamicResource AccentStatePressedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowAccentGlow}"/>
        <Style.Triggers>
            <!-- Выключенная кнопка не светится -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Второстепенное действие: без заливки, подложка только под курсором -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Необратимое действие: удалить, сбросить -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}"/>
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource AccentStateHoverBrush}"/>
        <Setter Property="controls:Appearance.PressedBrush" Value="{DynamicResource AccentStatePressedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Квадратная кнопка со значком; символ задаётся через Appearance.Icon, подпись — через ToolTip -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource SpaceNone}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Пункт меню из кнопок: во всю ширину, значок и подпись слева -->
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="{StaticResource PaddingMenuItem}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
    </Style>

    <!-- Кнопки окна в своём заголовке -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="{StaticResource CaptionButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource CaptionHeight}"/>
        <Setter Property="Padding" Value="{StaticResource SpaceNone}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeIconSmall}"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusNone}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource CloseHoverBrush}"/>
        <Setter Property="controls:Appearance.PressedBrush" Value="{DynamicResource CloseHoverBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnCloseHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопка-переключатель: выбранная подсвечена мягким акцентом -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource StateHoverBrush}"/>
        <Setter Property="controls:Appearance.PressedBrush" Value="{DynamicResource StatePressedBrush}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Повторяющаяся кнопка вне слайдеров и прокрутки выглядит как обычная -->
    <Style TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource StateHoverBrush}"/>
        <Setter Property="controls:Appearance.PressedBrush" Value="{DynamicResource StatePressedBrush}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

</ResourceDictionary>
