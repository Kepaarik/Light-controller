<!-- Кнопки: обычная, Accent, Ghost, Danger, кнопка-значок, пункт меню, чип, кнопка-переключатель -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LightSpace.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightSpace;component/Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Общий шаблон кнопок: под курсором фон заменяется на Appearance.HoverBrush, нажатая кнопка чуть прозрачнее.
         Значок слева от подписи — из Appearance.Icon -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{Binding (controls:Appearance.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconGlyph"
                           Text="{Binding (controls:Appearance.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource FontIcon}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ContentPresenter x:Name="Content" Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="controls:Appearance.Icon" Value="{x:Null}">
                <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="IconGlyph" Property="Margin" Value="{StaticResource SpaceNone}"/>
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{Binding (controls:Appearance.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Обычная кнопка: полупрозрачная заливка без рамки -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

    <!-- Главное действие: заливка акцентным градиентом -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource AccentGradientHoverBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Второстепенное действие: без заливки, подложка только под курсором -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingCompact}"/>
    </Style>

    <!-- Необратимое действие: удалить, сбросить — красный текст без заливки -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource ControlBrush}"/>
    </Style>

    <!-- Квадратная кнопка со значком; символ задаётся через Appearance.Icon, подпись — через ToolTip -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Padding" Value="{StaticResource SpaceNone}"/>
    </Style>

    <!-- Пункт меню из кнопок: во всю ширину, значок и подпись слева -->
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="{StaticResource PaddingMenuItem}"/>
    </Style>

    <!-- Небольшая кнопка-чип, например пресет стекла -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="{StaticResource PaddingChip}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    </Style>

    <!-- Кнопка-переключатель: выбранная подсвечена мягким акцентом -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Повторяющаяся кнопка вне слайдеров и прокрутки выглядит как обычная -->
    <Style TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="controls:Appearance.HoverBrush" Value="{DynamicResource ControlHoverBrush}"/>
        <Setter Property="controls:Appearance.CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
    </Style>

</ResourceDictionary>
