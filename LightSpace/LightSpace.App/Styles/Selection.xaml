<!-- Выбор из набора: списки, сегменты, вариант-приложение, плитки-галерея, палитра, вкладки заголовка окна -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LightSpace.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightSpace;component/Themes/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Список: прозрачный, со своей тонкой прокруткой -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="{StaticResource SpaceNone}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка списка: подложка под курсором, у выбранной — акцентная черта слева -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingListItem}"/>
        <Setter Property="Margin" Value="{StaticResource GapBottom4}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Marker" Width="{StaticResource TabIndicatorHeight}" Height="{StaticResource TabIndicatorWidth}"
                                    CornerRadius="{StaticResource RadiusPill}" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Hidden"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="controls:Appearance.ForceHover" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBrush}"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вариант в сегментах: под курсором подложка, выбранный залит акцентом, недоступный (IsEnabled=False) приглушён.
         Чтобы выключить отдельные варианты, ItemContainerStyle списка наследуется от этого стиля с привязкой IsEnabled -->
    <Style x:Key="SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingControl}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="controls:Appearance.ForceHover" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Сегменты: 2–5 вариантов в одну строку, выбранный залит акцентом. Замена ComboBox и RadioButton.
         Варианты — ItemsSource, выбор — SelectedItem или SelectedValue -->
    <Style x:Key="Segments" TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource StrokeThin}" CornerRadius="{StaticResource RadiusControl}"
                            Padding="{StaticResource PaddingSegments}" SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}"/>
    </Style>

    <!-- Приложение в выпадающей панели выбора и на её кнопке: значок, название и имя exe-файла.
         Вариант показывает Icon (картинка значка), Title и ExeName -->
    <DataTemplate x:Key="AppOptionTemplate">
        <DockPanel>
            <Grid DockPanel.Dock="Left" Width="{StaticResource AppIconSize}" Height="{StaticResource AppIconSize}"
                  Margin="{StaticResource GapRight12}" VerticalAlignment="Center">
                <!-- Без значка — общий значок приложения -->
                <TextBlock Text="&#xE737;" FontFamily="{StaticResource FontIcon}" FontSize="{StaticResource FontSizeIcon}"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Image Source="{Binding Icon}"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ExeName}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <!-- Галерея плиток с картинкой: эффекты, встроенные эффекты устройств. Своей прокрутки нет, чтобы колесо листало страницу.
         Плитка показывает Preview (кисть-превью; на этапе 2 сюда встанет живое превью эффекта) и Title -->
    <Style x:Key="TileGallery" TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter x:Name="Root"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <!-- Место под картинку: подложка видна, пока превью нет -->
                        <Grid Height="{StaticResource TilePreviewHeight}">
                            <Border CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource TrackBrush}"/>
                            <Border CornerRadius="{StaticResource RadiusSmall}" Background="{Binding Preview}"/>
                        </Grid>
                        <TextBlock Text="{Binding Title}" Margin="{StaticResource TileTitleMargin}" TextTrimming="CharacterEllipsis"
                                   FontSize="{StaticResource FontSizeCaption}"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="{StaticResource TileWidth}"/>
                    <Setter Property="Margin" Value="{StaticResource GapTile}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root" CornerRadius="{StaticResource RadiusControl}" Background="{DynamicResource ControlBrush}"
                                        Padding="{StaticResource PaddingTile}" BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="{StaticResource StrokeThick}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="controls:Appearance.ForceHover" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Палитра: круглые образцы цветов в ряд, выбранный обведён кольцом. Варианты — цвета (Color) в ItemsSource,
         выбор — SelectedItem. Например, цвет обводки группы из GroupPalette -->
    <Style x:Key="SwatchPalette" TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter x:Name="Root"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Ellipse Width="{StaticResource SwatchSize}" Height="{StaticResource SwatchSize}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="{StaticResource GapRight4}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Ring" CornerRadius="{StaticResource RadiusPill}" Padding="{StaticResource Space4}"
                                        BorderBrush="Transparent" BorderThickness="{StaticResource StrokeThick}" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}"/>
                                    </Trigger>
                                    <Trigger Property="controls:Appearance.ForceHover" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки в заголовке окна: текст, у выбранной — акцентная черта снизу -->
    <Style x:Key="TitleTabs" TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="Padding" Value="{StaticResource PaddingTab}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Background="Transparent">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                    <Border x:Name="Indicator" Width="{StaticResource TabIndicatorWidth}" Height="{StaticResource TabIndicatorHeight}"
                                            CornerRadius="{StaticResource RadiusPill}" Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="{StaticResource GapBottom8}"
                                            Visibility="Hidden"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
