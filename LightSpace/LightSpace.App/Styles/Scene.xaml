<!-- Сцена в стиле LedHub: карточка устройства, рамка группы, живое превью,
     перетаскиваемая строка, рамка выделения мышью, холст и слои -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LightSpace.App.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/LightSpace;component/Themes/Tokens.xaml"/>
        <ResourceDictionary Source="/LightSpace;component/Styles/Text.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Карточка устройства на сцене: стеклянная панель, под курсором светлее, выбранная (Appearance.IsSelected)
         обведена акцентом. Обводка всегда толстая, чтобы выбор не сдвигал содержимое -->
    <Style x:Key="DeviceCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThick}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="controls:Appearance.IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Рамка группы на сцене: обводка цветом группы (BorderBrush), внутри заголовок и карточки устройств группы.
         Выбранная группа (Appearance.IsSelected) подсвечена мягким акцентом -->
    <Style x:Key="GroupFrame" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThick}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource Space8}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            </Trigger>
            <Trigger Property="controls:Appearance.IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Заголовок рамки группы: название слева -->
    <Style x:Key="GroupFrameHeader" TargetType="DockPanel">
        <Setter Property="Margin" Value="{StaticResource GroupHeaderMargin}"/>
    </Style>

    <!-- Строка списка, которую можно перетащить на другое место (DragReorder): например, слой в редакторе сцены.
         Выглядит как строка списка: под курсором светлее, выбранная (Appearance.IsSelected) — с мягкой акцентной обводкой,
         пока её тянут (DragReorder.IsDragging) — залита акцентом -->
    <Style x:Key="ReorderRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="{StaticResource GapBottom4}"/>
        <Setter Property="Cursor" Value="SizeAll"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="controls:Appearance.IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}"/>
            </Trigger>
            <Trigger Property="controls:DragReorder.IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Крупное живое превью содержимого в редакторе: кадр эффекта задаёт Background -->
    <Style x:Key="LivePreview" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource ScenarioPreviewHeight}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
    </Style>

    <!-- Значок-ручка слева в перетаскиваемой строке -->
    <Style x:Key="GripIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="Text" Value="&#xE76F;"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeIconSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Margin" Value="{StaticResource GapRight12}"/>
    </Style>

    <!-- Рамка выделения мышью поверх сцены -->
    <Style x:Key="SelectionBand" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Подложка карты сцены — холст, на котором стоят устройства, как в LedHub: тёмная вставка в стекле.
         Ставится на карту SceneMap отдельным элементом на место SceneMap.WholeScene; в редакторе слоёв её фон
         заменяет кадр всей сцены -->
    <Style x:Key="SceneSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InsetBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- Устройство на карте сцены: фон — его живые цвета. Под курсором обводка ярче, выбранное (Appearance.IsSelected)
         обведено акцентом, перетаскиваемое (Appearance.IsMovable) показывает курсор перемещения -->
    <Style x:Key="SceneDevice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="controls:Appearance.IsMovable" Value="True">
                <Setter Property="Cursor" Value="SizeAll"/>
            </Trigger>
            <Trigger Property="controls:Appearance.IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="{StaticResource StrokeThick}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Рамка группы на карте сцены вокруг её устройств: как рамка группы, но без внутренних отступов -->
    <Style x:Key="MapGroupFrame" TargetType="Border" BasedOn="{StaticResource GroupFrame}">
        <Setter Property="Padding" Value="{StaticResource SpaceNone}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
    </Style>

    <!-- Подпись над элементом карты сцены: название группы или устройства -->
    <Style x:Key="MapLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Margin" Value="{StaticResource GapBottom4}"/>
    </Style>

    <!-- Границы слоя сцены на холсте: пунктир. Под курсором ярче, выбранный слой (Appearance.IsSelected) обведён
         сплошной линией акцентом -->
    <Style x:Key="LayerBounds" TargetType="Rectangle">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="StrokeThickness" Value="{StaticResource StrokeWidthThick}"/>
        <Setter Property="StrokeDashArray" Value="{StaticResource DashPattern}"/>
        <Setter Property="Cursor" Value="SizeAll"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="controls:Appearance.IsSelected" Value="True">
                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ярлык слоя в левом верхнем углу его границ: читается поверх любых цветов сцены -->
    <Style x:Key="LayerTag" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PopupBrush}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="{StaticResource PaddingTooltip}"/>
        <Setter Property="Margin" Value="{StaticResource Space4}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Ручка в правом нижнем углу границ выбранного слоя: её тянут, чтобы изменить размер границ -->
    <Style x:Key="LayerHandle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource LayerHandleSize}"/>
        <Setter Property="Height" Value="{StaticResource LayerHandleSize}"/>
        <Setter Property="Margin" Value="{StaticResource LayerHandleMargin}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="{StaticResource StrokeThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Cursor" Value="SizeNWSE"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
