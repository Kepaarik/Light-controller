<UserControl x:Class="LightSpace.App.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:views="clr-namespace:LightSpace.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SceneViewModel}">

    <!-- Устройство, открытое в левом меню: яркость, монитор ленты и что на устройстве играет.
         Справа выезжает панель с настройками выбранного эффекта -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PaddingPage}">
            <!-- Шапка: значок из меню (щелчок — выбрать другой), название с переименованием, тип и состояние связи -->
            <DockPanel>
                <Grid DockPanel.Dock="Left" VerticalAlignment="Top" Margin="{StaticResource HeaderIconMargin}">
                    <ToggleButton x:Name="IconOpener" Width="48" Height="48" Padding="{StaticResource SpaceNone}"
                                  ToolTip="Значок в левом меню"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=IconFlyout, Converter={x:Static controls:InverseBooleanConverter.Instance}}">
                        <TextBlock Text="{Binding SelectedGroup.Device.Icon}" Style="{StaticResource Icon}" FontSize="22"/>
                    </ToggleButton>

                    <Popup x:Name="IconFlyout" PlacementTarget="{Binding ElementName=IconOpener}" Placement="Bottom" StaysOpen="False"
                           HorizontalOffset="{StaticResource FlyoutOffsetX}" VerticalOffset="{StaticResource FlyoutOffsetY}"
                           AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=IconOpener, Mode=TwoWay}">
                        <Border Style="{StaticResource FlyoutCard}" Width="240">
                            <StackPanel Margin="{StaticResource Space8}">
                                <TextBlock Text="Значок в меню" Style="{StaticResource Caption}" Margin="{StaticResource GapBottom8}"/>
                                <ListBox x:Name="IconList" ItemsSource="{x:Static vm:DeviceIcons.All}"
                                         SelectedItem="{Binding SelectedGroup.Device.Icon, Mode=OneWay}"
                                         SelectionChanged="OnIconSelected" FocusVisualStyle="{x:Null}">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Icon}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Root" Width="40" Height="40" Margin="{StaticResource GapTile}"
                                                                CornerRadius="{StaticResource RadiusInner}" Background="Transparent"
                                                                BorderBrush="Transparent" BorderThickness="{StaticResource StrokeThick}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentGradientBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Выключатель устройства — справа в шапке; у неподключённого тоже: оно останется выключенным, когда найдётся -->
                <CheckBox x:Name="PowerSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="{StaticResource GapLeft24}"
                          ToolTip="Подсветка устройства" IsChecked="{Binding SelectedGroup.Device.IsOn, Mode=OneWay}"
                          Click="OnPowerClicked"/>

                <!-- Яркость устройства — в шапке, под рукой; у неподключённого её нет -->
                <controls:ValueSlider DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Margin="{StaticResource GapLeft24}"
                                      Label="Яркость" Unit="%" Minimum="0" Maximum="100" Step="1"
                                      Value="{Binding SelectedGroup.Brightness}"
                                      Visibility="{Binding SelectedGroup.Device.IsConnected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <TextBlock x:Name="TitleText" Text="{Binding SelectedGroup.Title}" Style="{StaticResource PageTitle}"
                                       Margin="{StaticResource SpaceNone}"/>
                            <!-- Поле названия: Enter или уход фокуса сохраняет, Esc — отменяет; пустое возвращает название устройства -->
                            <TextBox x:Name="NameBox" FontSize="{StaticResource FontSizeTitle}" MinWidth="280" HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center" Visibility="Collapsed"
                                     KeyDown="OnNameKeyDown" LostKeyboardFocus="OnNameLostFocus"/>
                        </Grid>
                        <Button x:Name="RenameButton" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE70F;"
                                ToolTip="Переименовать" VerticalAlignment="Center" Margin="{StaticResource GapLeft8}" Click="OnRenameClicked"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}">
                        <Run Text="{Binding SelectedGroup.Device.KindText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedGroup.Device.StatusTitle, Mode=OneWay}">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGroup.Device.Status}" Value="Connected">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedGroup.Device.Status}" Value="NeedsSetup">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedGroup.Device.Status}" Value="Failing">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Живые цвета, которые сейчас уходят на устройство; у встроенного эффекта их не знает и само приложение -->
            <Border Height="10" CornerRadius="5" Margin="{StaticResource GapTop16}" Background="{Binding SelectedGroup.Device.Preview}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource StrokeThin}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGroup.Device.IsConnected}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedGroup.Device.IsBuiltinPlaying}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Неподключённому устройству настраивать нечего: команды до него не дойдут -->
            <controls:EmptyState Icon="&#xE772;" Title="Устройство не подключено" Margin="{StaticResource GapTop64}"
                                 Hint="Включите его и запустите поиск — настройки появятся здесь."
                                 ActionText="Найти устройства" ActionIcon="&#xE721;"
                                 Command="{Binding DataContext.FindDevicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding SelectedGroup.Device.IsConnected, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

            <StackPanel Visibility="{Binding SelectedGroup.Device.IsConnected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <!-- Лента за монитором: пока она играет «Экран», она берёт цвета краёв этого монитора -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}"
                    Visibility="{Binding IsStripSelected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="Монитор" Style="{StaticResource CardTitle}"/>
                    <ListBox Style="{StaticResource Segments}" HorizontalAlignment="Left"
                             ItemsSource="{Binding MonitorOptions}" SelectedItem="{Binding SelectedMonitor}"/>
                    <TextBlock Text="Лента за монитором в эффекте «Экран» повторяет цвета его краёв. Раскладку ленты по краям настройте на странице «Мониторы»."
                               Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}">
                <StackPanel>
                    <!-- Что играет: тип содержимого, ниже его настройки. Новый эффект останавливает и стирает прежний -->
                    <DockPanel>
                        <!-- Открывает и прячет панель настроек эффекта справа -->
                        <ToggleButton x:Name="SettingsToggle" DockPanel.Dock="Right" IsChecked="True" Content="Настройки"
                                      controls:Appearance.Icon="&#xE713;" VerticalAlignment="Top"
                                      Visibility="{Binding IsEffectContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                        <TextBlock Text="Эффект" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <ListBox Style="{StaticResource Segments}" HorizontalAlignment="Left"
                             ItemsSource="{Binding ContentKinds}" SelectedItem="{Binding SelectedContentKind}"
                             Margin="{StaticResource GapBottom16}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentItem}">
                                <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Вкладку только открыли: играет прежнее, пока здесь не выберут эффект или не нажмут «Включить» -->
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusControl}"
                            Padding="{StaticResource PaddingBanner}" Margin="{StaticResource GapBottom16}"
                            Visibility="{Binding IsViewedKindIdle, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Включить" Style="{StaticResource AccentButton}"
                                    controls:Appearance.Icon="&#xE768;" Command="{Binding PlayViewedKindCommand}"/>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Margin="{StaticResource GapRight12}"/>
                            <TextBlock Text="{Binding PlayingText}" Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- Эффект: сверху встроенные эффекты устройства, ниже галерея эффектов приложения; настройки — в панели справа -->
                    <StackPanel Visibility="{Binding IsEffectContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <StackPanel Visibility="{Binding BuiltinEditor.HasTiles, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text="Встроенные эффекты устройства" Style="{StaticResource SectionLabel}"/>
                            <ListBox Style="{StaticResource TileGallery}" ItemsSource="{Binding BuiltinEditor.Tiles}"
                                     SelectedItem="{Binding BuiltinEditor.SelectedTile}"/>

                            <TextBlock Text="Эффекты приложения" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <views:EffectEditor DataContext="{Binding Editor}" ShowsSettings="False"/>
                    </StackPanel>

                    <!-- Музыка: живое превью, источник звука, режим, цвета и отклик -->
                    <StackPanel Visibility="{Binding IsMusicContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <views:MusicEditor DataContext="{Binding MusicEditor}"/>
                    </StackPanel>

                    <!-- Экран: лента повторяет цвета краёв своего монитора; монитор выбирается выше -->
                    <StackPanel Visibility="{Binding IsScreenContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <TextBlock Text="Лента повторяет цвета краёв монитора, за которым висит. Раскладку ленты по краям настройте на странице «Мониторы»."
                                   Style="{StaticResource Hint}" Margin="{StaticResource GapBottom16}"/>
                        <controls:ValueSlider Label="Насыщенность" Unit="%" Minimum="0" Maximum="200" Step="5"
                                              Value="{Binding ScreenEditor.Saturation}" Margin="{StaticResource GapBottom16}"/>
                        <controls:ValueSlider Label="Яркость" Unit="%" Minimum="10" Maximum="200" Step="5"
                                              Value="{Binding ScreenEditor.Brightness}" Margin="{StaticResource GapBottom16}"/>
                        <controls:ValueSlider Label="Сглаживание" Unit="%" Minimum="0" Maximum="95" Step="5"
                                              Value="{Binding ScreenEditor.Smoothing}"/>
                        <TextBlock Text="Сильное сглаживание делает смену цветов плавнее, но свет отстаёт от картинки."
                                   Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
                    </StackPanel>

                    <!-- Встроенный эффект: подсказка вместо превью, эффект устройства, скорость и цвет -->
                    <StackPanel Visibility="{Binding IsBuiltinContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <views:BuiltinEditor DataContext="{Binding BuiltinEditor}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

        <!-- Панель настроек эффекта: только у «Эффекта», выезжает справа -->
        <Grid Grid.Column="1" Visibility="{Binding SelectedGroup.Device.IsConnected, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
        <Grid Visibility="{Binding IsEffectContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <Border Width="{StaticResource EffectPanelWidth}" Margin="{StaticResource EffectPanelMargin}" Padding="{StaticResource SpaceNone}"
                    Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="48" To="0" Duration="{StaticResource MotionSlow}"
                                                             EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                             Duration="{StaticResource MotionSlow}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="{StaticResource PaddingCard}">
                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsChecked, ElementName=SettingsToggle}"
                                      controls:Appearance.Icon="&#xE711;" ToolTip="Скрыть настройки" VerticalAlignment="Top"
                                      Width="{StaticResource IconButtonSize}" Height="{StaticResource IconButtonSize}"
                                      Padding="{StaticResource SpaceNone}" Background="Transparent" BorderBrush="Transparent"/>
                        <TextBlock Text="Настройки эффекта" Style="{StaticResource CardTitle}"/>
                    </DockPanel>

                    <!-- Настройки того, что играет: встроенного эффекта устройства или эффекта приложения -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Те же поля, что у карточки, кроме верхнего: сверху уже заголовок панели -->
                        <Grid Margin="{StaticResource PaddingCardBody}">
                            <views:EffectSettings DataContext="{Binding Editor}"
                                                  Visibility="{Binding DataContext.IsBuiltinPlaying, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>
                            <views:BuiltinSettings DataContext="{Binding BuiltinEditor}"
                                                   Visibility="{Binding DataContext.IsBuiltinPlaying, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
