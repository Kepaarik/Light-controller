<UserControl x:Class="LightSpace.App.Views.SceneEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:views="clr-namespace:LightSpace.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfileSceneViewModel}">

    <!-- Сцена одной карточкой: холст с живым превью, место выбранного устройства, режим, направление и яркость.
         Эффект сцены и настройки устройств — в панели справа от сцены -->
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Удалить сцену" controls:Appearance.Icon="&#xE74D;"
                        VerticalAlignment="Center" Command="{Binding RemoveCommand}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Сцена" Style="{StaticResource CardTitle}" Margin="{StaticResource SpaceNone}"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <controls:SceneCanvas Scene="{Binding}" Height="{StaticResource SceneCanvasHeight}" Margin="{StaticResource GapTop16}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"
                       Text="Щелчок по устройству открывает его настройки справа, щелчок мимо — эффект сцены. Устройство перетаскивают мышью, колесо меняет его размер."/>

            <!-- Место выбранного на холсте устройства: поворот, размер и выход из сцены -->
            <DockPanel Margin="{StaticResource GapTop16}"
                       Visibility="{Binding HasSelectedDevice, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <Button DockPanel.Dock="Left" Content="Повернуть" controls:Appearance.Icon="&#xE7AD;"
                        VerticalAlignment="Center" Margin="{StaticResource GapRight12}" Command="{Binding RotateSelectedCommand}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Убрать из сцены" controls:Appearance.Icon="&#xE711;"
                        VerticalAlignment="Center" Margin="{StaticResource GapLeft12}" Command="{Binding RemoveSelectedCommand}"/>
                <controls:ValueSlider Label="Размер" Unit="%" Minimum="5" Maximum="100" Step="1"
                                      Value="{Binding SelectedDevice.SizePercent}"/>
            </DockPanel>

            <!-- Как эффект идёт по сцене и насколько ярко -->
            <Grid Margin="{StaticResource GapTop16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Content="Синхронно" IsChecked="{Binding IsSynced}" VerticalAlignment="Bottom" Margin="{StaticResource GapRight12}"
                          ToolTip="Выключено — эффект идёт по холсту с устройства на устройство. Включено — каждое устройство играет эффект целиком, все в такт."/>
                <controls:ValueSlider Grid.Column="1" Label="Яркость сцены" Unit="%" Minimum="0" Maximum="100" Step="1"
                                      Value="{Binding Brightness}" Margin="{StaticResource GapLeft12}"/>
            </Grid>

            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Directions}" SelectedItem="{Binding SelectedDirection}"
                     Margin="{StaticResource GapTop16}"/>
        </StackPanel>
    </Border>
</UserControl>
