<UserControl x:Class="LightSpace.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PaddingPage}" MaxWidth="{StaticResource WideContentMaxWidth}" HorizontalAlignment="Left">
            <!-- Семь щелчков по заголовку открывают скрытый раздел «Журнал устройств» -->
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}" MouseLeftButtonUp="OnTitleClicked"/>
            <TextBlock Text="Внешний вид и поведение приложения" Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>

            <!-- Найдена новая версия: заметная плашка над карточками, а не только строка в «О приложении» -->
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusControl}"
                    Padding="{StaticResource PaddingBanner}" Margin="{StaticResource GapTop24}"
                    Visibility="{Binding HasUpdate, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Скачать" controls:Appearance.Icon="&#xE896;"
                            Command="{Binding OpenUpdateCommand}" Margin="{StaticResource GapLeft12}"/>
                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="{StaticResource GapRight12}"/>
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Карточки в две колонки: слева то, чем пользуются чаще, — подсветка, запуск и версия; справа внешний вид и стекло -->
            <Grid Margin="{StaticResource GapTop24}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="2">
            <!-- Внешний вид -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Внешний вид" Style="{StaticResource CardTitle}"/>
                    <CheckBox IsChecked="{Binding UseAcrylic}" IsEnabled="{Binding IsAcrylicSupported}">
                        <StackPanel>
                            <TextBlock Text="Прозрачное стекло" Style="{StaticResource Body}"/>
                            <TextBlock Text="Сквозь окно видно, что под ним, — размыто, как через матовое стекло. Выключите, чтобы окно было матовым (Mica): спокойнее и чуть экономнее."
                                       Style="{StaticResource Hint}" Margin="{StaticResource GapTextPair}"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Стекло доступно в Windows 11 22H2 и новее; в этой системе окно тёмное."
                               Style="{StaticResource Warning}" Margin="{StaticResource GapTop12}"
                               Visibility="{Binding IsAcrylicSupported, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- Тонированное стекло: пресет как отправная точка, дальше — ползунки -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}">
                <StackPanel>
                    <TextBlock Text="Стекло" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Готовые варианты" Style="{StaticResource Hint}" Margin="{StaticResource GapBottom8}"/>
                    <ItemsControl ItemsSource="{Binding Glass.Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Margin="{StaticResource GapWrap}"
                                        Command="{Binding DataContext.Glass.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Swatch}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="{Binding Title}" Margin="{StaticResource GapLeft8}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ползунки нужны редко: обычно хватает готового варианта, поэтому они в закрытом разделе -->
                    <Expander Header="Тонкая настройка" Style="{StaticResource Disclosure}">
                    <StackPanel>
                    <controls:ValueSlider Label="Прозрачность" Unit="%" Minimum="0" Maximum="100" Step="1"
                                          Value="{Binding Glass.Transparency}"/>

                    <DockPanel Margin="{StaticResource GapTop16}">
                        <Border DockPanel.Dock="Right" Width="16" Height="16" CornerRadius="8" Margin="{StaticResource GapLeft12}"
                                VerticalAlignment="Bottom" Background="{Binding Glass.TintSwatch}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <controls:ValueSlider Label="Оттенок тонировки" Unit="°" Minimum="0" Maximum="359" Step="1"
                                              Value="{Binding Glass.TintHue}"/>
                    </DockPanel>

                    <controls:ValueSlider Label="Сила тонировки" Unit="%" Minimum="0" Maximum="100" Step="1"
                                          Value="{Binding Glass.TintStrength}" Margin="{StaticResource GapTop16}"/>
                    <controls:ValueSlider Label="Плотность карточек" Unit="%" Minimum="0" Maximum="100" Step="1"
                                          Value="{Binding Glass.Frost}" Margin="{StaticResource GapTop16}"/>
                    <controls:ValueSlider Label="Блик по краю" Unit="%" Minimum="0" Maximum="100" Step="1"
                                          Value="{Binding Glass.Shine}" Margin="{StaticResource GapTop16}"/>

                    <TextBlock Text="Тонировка ложится поверх системного стекла: при выключенном «Прозрачном стекле» окно матовое, но цвет и блик всё равно меняются."
                               Style="{StaticResource Hint}" Margin="{StaticResource GapTop12}"/>
                    </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel Grid.Column="0">
            <!-- Подсветка -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Подсветка" Style="{StaticResource CardTitle}"/>
                    <CheckBox IsChecked="{Binding LightingEnabled}">
                        <StackPanel>
                            <TextBlock Text="Подсветка включена" Style="{StaticResource Body}"/>
                            <TextBlock Text="Выключает свет на всех устройствах сразу; то же есть в меню значка в трее"
                                       Style="{StaticResource Hint}" Margin="{StaticResource GapTextPair}"/>
                        </StackPanel>
                    </CheckBox>

                    <controls:ValueSlider Label="Общая яркость" Unit="%" Minimum="0" Maximum="100" Step="1" Margin="{StaticResource GapTop16}"
                                          Value="{Binding DataContext.MasterBrightness, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Text="Приглушает все устройства разом, их собственная яркость не меняется"
                               Style="{StaticResource Hint}" Margin="{StaticResource GapTop8}"/>
                </StackPanel>
            </Border>

            <!-- Приложение -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}">
                <StackPanel>
                    <TextBlock Text="Запуск" Style="{StaticResource CardTitle}"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}">
                        <StackPanel>
                            <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource Body}"/>
                            <TextBlock Text="Light Space стартует сразу в трей, без окна" Style="{StaticResource Hint}" Margin="{StaticResource GapTextPair}"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Свернуть — окно прячется в трей, подсветка продолжает работать. Закрыть — приложение завершается."
                               Style="{StaticResource Hint}" Margin="{StaticResource GapTop16}"/>
                </StackPanel>
            </Border>

            <!-- О приложении: версия; найденное обновление — в плашке наверху страницы -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}">
                <StackPanel>
                    <TextBlock Text="О приложении" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Body}"/>
                </StackPanel>
            </Border>
            </StackPanel>
            </Grid>

            <!-- Скрытый раздел: подробный журнал устройств для разбора неполадок -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}"
                    Visibility="{Binding Log.IsShown, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="Журнал устройств" Style="{StaticResource CardTitle}"/>
                    <CheckBox IsChecked="{Binding Log.IsEnabled}">
                        <StackPanel>
                            <TextBlock Text="Записывать подробный журнал" Style="{StaticResource Body}"/>
                            <TextBlock Text="Поиск, подключение и каждая команда, ушедшая на устройство. Включите, затем нажмите «Найти» на странице «Устройства» и повторите то, что не работает."
                                       Style="{StaticResource Hint}" Margin="{StaticResource GapTextPair}"/>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource GapTop16}">
                        <Button Content="Скопировать" controls:Appearance.Icon="&#xE8C8;" Command="{Binding Log.CopyCommand}"/>
                        <Button Content="Открыть папку" controls:Appearance.Icon="&#xE838;" Command="{Binding Log.OpenFolderCommand}"
                                Style="{StaticResource GhostButton}" Margin="{StaticResource GapLeft8}"/>
                        <Button Content="Очистить" Command="{Binding Log.ClearCommand}" Style="{StaticResource DangerButton}" Margin="{StaticResource GapLeft8}"/>
                    </StackPanel>

                    <TextBox Text="{Binding Log.Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" Height="320" Margin="{StaticResource GapTop16}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             TextChanged="OnLogTextChanged"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
