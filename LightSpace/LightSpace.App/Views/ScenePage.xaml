<UserControl x:Class="LightSpace.App.Views.ScenePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:views="clr-namespace:LightSpace.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <!-- Ctrl+Z отменяет последний шаг в режиме редактирования расстановки -->
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Scene.UndoCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Настройки эффекта — в общем редакторе EffectEditor -->

        <!-- Устройство на карте сцены с живыми цветами: лента — полоса своих светодиодов, клавиатура — раскладка
             с закрашенными клавишами, устройство одного цвета — кружок. Имя DeviceShape ищет мышь в ScenePage.xaml.cs -->
        <DataTemplate x:Key="DeviceShapeTemplate" DataType="vm:SceneDeviceViewModel">
            <Border x:Name="DeviceShape" Background="{Binding Preview}"
                    controls:Appearance.IsSelected="{Binding IsSelected}"
                    controls:Appearance.IsMovable="{Binding DataContext.IsEditingLayout, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}"/>
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Играет встроенный эффект устройства — его цвета здесь не видны" Style="{StaticResource Caption}"
                                   Visibility="{Binding IsBuiltinPlaying, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </Border.ToolTip>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SceneDevice}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPoint}" Value="True">
                                <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Viewbox Stretch="Fill" Visibility="{Binding IsKeyboard, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <controls:KeyboardLayout Keys="{Binding Keys}" Colors="{Binding KeyColors}"/>
                    </Viewbox>

                    <!-- Встроенный эффект устройство играет само, его цвета неизвестны — вместо них знак молнии -->
                    <Viewbox MaxHeight="{StaticResource IconButtonSize}" IsHitTestVisible="False"
                             Visibility="{Binding IsBuiltinPlaying, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}"/>
                    </Viewbox>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Группа на карте сцены: рамка её цвета вокруг её устройств, над рамкой название.
             У устройства без группы рамки нет, только подпись. Имя GroupFrame ищет мышь в ScenePage.xaml.cs -->
        <DataTemplate x:Key="MapGroupTemplate" DataType="vm:SceneGroupViewModel">
            <Grid>
                <Border x:Name="GroupFrame" Style="{StaticResource MapGroupFrame}" BorderBrush="{Binding OutlineBrush}"
                        controls:Appearance.IsSelected="{Binding IsSelected}"/>
                <Canvas VerticalAlignment="Top" Height="0" IsHitTestVisible="False">
                    <TextBlock Canvas.Bottom="0" Text="{Binding Title, Mode=OneWay}" Style="{StaticResource MapLabel}"/>
                </Canvas>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSolo}" Value="True">
                    <Setter TargetName="GroupFrame" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Элементы карты стоят на своих местах на сцене -->
        <Style x:Key="MapItem" TargetType="ContentPresenter">
            <Setter Property="controls:SceneMap.Place" Value="{Binding Place}"/>
        </Style>

        <Style x:Key="MapDevice" TargetType="ContentPresenter">
            <Setter Property="controls:SceneMap.Place" Value="{Binding Place}"/>
            <Setter Property="controls:SceneMap.Angle" Value="{Binding Angle}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Пока устройств нет — пустое состояние; живая карта стола появится вместе с устройствами -->
        <controls:EmptyState Icon="&#xE7F4;" Title="Устройств пока нет" Hint="Light Space найдёт ленты и клавиатуры в сети, по Bluetooth и USB. Найденные устройства появятся на карте стола, их можно будет собрать в группы." ActionText="Найти устройства" ActionIcon="&#xE721;" Command="{Binding FindDevicesCommand}"
                             Visibility="{Binding Devices.HasDevices, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

        <!-- Устройства есть: слева их живые цвета на карте стола, справа эффект, который на них играет -->
        <Grid DataContext="{Binding Scene}" Margin="{StaticResource PaddingPage}"
              Visibility="{Binding DataContext.Devices.HasDevices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource ScenePanelWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- Живые цвета устройств по группам: клик выбирает группу или устройство, Ctrl+клик и рамка мышью выделяют
                 несколько устройств -->
            <DockPanel d:DataContext="{d:DesignInstance vm:SceneViewModel}">
                <!-- Заголовок и вход в режим редактирования расстановки -->
                <DockPanel DockPanel.Dock="Top">
                    <ToggleButton DockPanel.Dock="Right" Content="Редактировать расстановку" controls:Appearance.Icon="&#xE70F;"
                                  IsChecked="{Binding IsEditingLayout}" VerticalAlignment="Top"/>
                    <TextBlock Text="Сцена" Style="{StaticResource PageTitle}"/>
                </DockPanel>
                <!-- Что играет на устройствах: одно на всей сцене, своё у каждой группы или своё у каждого устройства -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="{StaticResource GapBottom8}">
                    <RadioButton GroupName="SceneMode" Content="Вся сцена" IsChecked="{Binding IsWholeScene}" Margin="{StaticResource GapRight4}"/>
                    <RadioButton GroupName="SceneMode" Content="Группы" IsChecked="{Binding IsGroupsMode}" Margin="{StaticResource GapRight4}"/>
                    <RadioButton GroupName="SceneMode" Content="Устройства" IsChecked="{Binding IsDevicesMode}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="{StaticResource GapBottom8}" Text="{Binding SceneHint}"/>
                <Grid>
                    <!-- Пустое место вокруг карты тоже ловит мышь: с него начинается рамка выделения -->
                    <Grid x:Name="SceneArea" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                          PreviewMouseLeftButtonDown="OnAreaMouseDown" MouseMove="OnAreaMouseMove"
                          MouseLeftButtonUp="OnAreaMouseUp" LostMouseCapture="OnAreaLostMouseCapture">
                        <!-- Карта стола: подложка, рамки групп с подписями, устройства на своих местах. Все слои карты одного
                             размера, поэтому совпадают точка в точку -->
                        <Grid x:Name="MapHost" Margin="{StaticResource SceneMapMargin}">
                            <controls:SceneMap>
                                <Border Style="{StaticResource SceneSurface}" controls:SceneMap.Place="{x:Static controls:SceneMap.WholeScene}"/>
                            </controls:SceneMap>

                            <!-- Рамки групп видны, только пока у групп свои эффекты -->
                            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource MapGroupTemplate}"
                                          ItemContainerStyle="{StaticResource MapItem}"
                                          Visibility="{Binding IsGroupsMode, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:SceneMap/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceShapeTemplate}"
                                          ItemContainerStyle="{StaticResource MapDevice}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:SceneMap/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SelectionBand" Style="{StaticResource SelectionBand}" Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </Grid>

                    <!-- Режим редактирования расстановки: автокомпоновка, поворот и размер выбранного устройства -->
                    <Border Style="{StaticResource FlyoutCard}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Visibility="{Binding IsEditingLayout, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <!-- В узкой колонке карты кнопки переносятся на следующую строку, а не обрезаются краем -->
                        <WrapPanel>
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE7A7;" ToolTip="Отменить (Ctrl+Z)"
                                    Command="{Binding UndoCommand}" Margin="{StaticResource GapRight4}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Автокомпоновка" controls:Appearance.Icon="&#xE8A9;"
                                    Command="{Binding AutoArrangeCommand}" Margin="{StaticResource GapRight4}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Повернуть" controls:Appearance.Icon="&#xE7AD;"
                                    Command="{Binding RotateDeviceCommand}" IsEnabled="{Binding HasEditedDevice}" Margin="{StaticResource GapRight4}"/>
                            <TextBox Tag="Поворот, °" ToolTip="Поворот, °" Text="{Binding EditedAngleText}" Width="{StaticResource NumberFieldWidth}"
                                     VerticalAlignment="Center" Margin="{StaticResource GapRight12}"
                                     Visibility="{Binding HasEditedDevice, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                            <controls:ValueSlider Label="Размер" Minimum="4" Maximum="200" Step="1" Value="{Binding EditedSize}"
                                                  Width="{StaticResource PickerMinWidth}" VerticalAlignment="Center" Margin="{StaticResource GapRight12}"
                                                  Visibility="{Binding HasEditedDevice, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                            <Button Style="{StaticResource AccentButton}" Content="Готово" controls:Appearance.Icon="&#xE8FB;"
                                    Command="{Binding FinishEditingCommand}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Выделено несколько устройств: всплывающая карточка с действием «Сделать группой» -->
                    <Border Style="{StaticResource FlyoutCard}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Visibility="{Binding IsGroupActionShown, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Body}" VerticalAlignment="Center"
                                       Margin="{StaticResource PaddingMenuItem}"/>
                            <Button Style="{StaticResource AccentButton}" Content="Сделать группой" controls:Appearance.Icon="&#xE902;"
                                    Command="{Binding MakeGroupCommand}" Margin="{StaticResource GapRight4}"/>
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE711;" ToolTip="Снять выделение"
                                    Command="{Binding ClearSelectionCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Панель выбранной группы или устройства: название и цвет, яркость, содержимое, действия группы.
                 Пока ничего не выбрано — подсказка -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="{StaticResource GapLeft24}" d:DataContext="{d:DesignInstance vm:SceneViewModel}">
                <Grid>
                    <controls:EmptyState Icon="&#xE8B3;" Title="{Binding NoSelectionTitle}" Hint="{Binding NoSelectionHint}"
                                         Visibility="{Binding HasSelection, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <!-- Группа: своё название и цвет обводки -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsNamedGroup, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="Название группы" Style="{StaticResource Hint}" Margin="{StaticResource GapBottom4}"/>
                                <TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Цвет обводки" Style="{StaticResource SectionLabel}"/>
                                <ListBox Style="{StaticResource SwatchPalette}" ItemsSource="{StaticResource GroupPalette}"
                                         SelectedItem="{Binding SelectedGroup.OutlineColor}"/>
                            </StackPanel>

                            <!-- Вся сцена: одно содержимое на всех устройствах -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsWholeScene, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="Вся сцена" Style="{StaticResource Subtitle}"/>
                                <TextBlock Text="То, что выбрано ниже, играет сразу на всех устройствах. Чтобы дать устройствам свои эффекты, переключитесь на «Группы» или «Устройства»."
                                           Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
                            </StackPanel>

                            <!-- Устройство без группы: его название вместо названия группы -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsUngroupedDevice, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SelectedGroup.Title}" Style="{StaticResource Subtitle}"/>
                                <TextBlock Text="Устройство без группы. Выделите его вместе с другими устройствами, чтобы сделать группу."
                                           Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
                            </StackPanel>

                            <!-- Режим «Устройства»: своё содержимое у этого устройства, группы не действуют -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsDeviceLighting, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SelectedGroup.Title}" Style="{StaticResource Subtitle}"/>
                                <TextBlock Text="То, что выбрано ниже, играет только на этом устройстве."
                                           Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
                            </StackPanel>

                            <controls:ValueSlider Label="Яркость" Unit="%" Minimum="0" Maximum="100" Step="1"
                                                  Value="{Binding SelectedGroup.Brightness}" Margin="{StaticResource GapTop16}"/>

                            <!-- Что играет: тип содержимого, ниже его настройки -->
                            <TextBlock Text="Содержимое" Style="{StaticResource SectionLabel}"/>
                            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding ContentKinds}" SelectedItem="{Binding SelectedContentKind}"
                                     Margin="{StaticResource GapBottom16}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentItem}">
                                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Эффект: галерея, ниже настройки выбранного эффекта -->
                            <StackPanel Visibility="{Binding IsEffectContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <views:EffectEditor DataContext="{Binding Editor}"/>
                            </StackPanel>

                            <!-- Сцена: холст со слоями и их границами, список слоёв и эффект выбранного слоя -->
                            <StackPanel Visibility="{Binding IsSceneContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <views:SceneEditor DataContext="{Binding SceneEditor}"/>
                            </StackPanel>

                            <!-- Экран: живое превью картинки монитора, монитор и настройки цветов -->
                            <StackPanel Visibility="{Binding IsScreenContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <views:ScreenEditor DataContext="{Binding ScreenEditor}"/>
                            </StackPanel>

                            <!-- Музыка: живое превью, источник звука, режим, цвета и отклик -->
                            <StackPanel Visibility="{Binding IsMusicContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <views:MusicEditor DataContext="{Binding MusicEditor}"/>
                            </StackPanel>

                            <!-- Игра: живое превью, игра и её подключение, фон, полоски и события -->
                            <StackPanel Visibility="{Binding IsGameContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <views:GameEditor DataContext="{Binding GameEditor}"/>
                            </StackPanel>

                            <!-- Встроенный эффект: подсказка вместо превью, эффект каждого устройства, скорость и цвет -->
                            <StackPanel Visibility="{Binding IsBuiltinContent, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <views:BuiltinEditor DataContext="{Binding BuiltinEditor}"/>
                            </StackPanel>

                            <!-- Устройства группы и действия с ней -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsNamedGroup, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="Устройства группы" Style="{StaticResource SectionLabel}"/>
                                <ItemsControl ItemsSource="{Binding SelectedGroup.Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:SceneDeviceViewModel">
                                            <Border Style="{StaticResource SettingRow}">
                                                <DockPanel VerticalAlignment="Center">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE738;"
                                                            ToolTip="Убрать из группы" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.Scene.RemoveFromGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource GhostButton}" Content="Разгруппировать" controls:Appearance.Icon="&#xE74D;"
                                        HorizontalAlignment="Left" Command="{Binding UngroupCommand}" Margin="{StaticResource GapTop8}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
