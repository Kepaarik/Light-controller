<UserControl x:Class="LightSpace.App.Views.ScenePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:views="clr-namespace:LightSpace.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <UserControl.Resources>
        <!-- Настройки эффекта — в общем редакторе EffectEditor -->

        <!-- Карточка устройства с живыми цветами. Имя DeviceCard ищет выделение мышью в ScenePage.xaml.cs -->
        <DataTemplate x:Key="DeviceCardTemplate" DataType="vm:SceneDeviceViewModel">
            <Border x:Name="DeviceCard" Style="{StaticResource DeviceCard}" Margin="{StaticResource GapBottom8}"
                    controls:Appearance.IsSelected="{Binding IsSelected}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="{StaticResource GapLeft12}"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Лента: полоса своих светодиодов; устройство одного цвета — одна заливка -->
                    <Border Height="{StaticResource LedBarHeight}" CornerRadius="{StaticResource RadiusSmall}"
                            Background="{Binding Preview}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="{StaticResource StrokeThin}" Margin="{StaticResource GapTop8}"
                            Visibility="{Binding IsKeyboard, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

                    <!-- Клавиатура: клавиши закрашены своими цветами -->
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="{StaticResource GapTop8}"
                             Visibility="{Binding IsKeyboard, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <controls:KeyboardLayout Keys="{Binding Keys}" Colors="{Binding KeyColors}"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Устройство без группы — просто его карточка -->
        <DataTemplate x:Key="SoloGroupTemplate" DataType="vm:SceneGroupViewModel">
            <ContentPresenter Content="{Binding Device}" ContentTemplate="{StaticResource DeviceCardTemplate}"/>
        </DataTemplate>

        <!-- Группа: рамка её цвета, название и играющий сценарий, внутри — карточки её устройств.
             Имя GroupFrame ищет клик мышью в ScenePage.xaml.cs -->
        <DataTemplate x:Key="GroupTemplate" DataType="vm:SceneGroupViewModel">
            <Border x:Name="GroupFrame" Style="{StaticResource GroupFrame}" BorderBrush="{Binding OutlineBrush}"
                    controls:Appearance.IsSelected="{Binding IsSelected}" Margin="{StaticResource GapBottom8}">
                <StackPanel>
                    <DockPanel Style="{StaticResource GroupFrameHeader}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveScenarioTitle, StringFormat='▶ {0}'}"
                                   Style="{StaticResource PlayingMark}" Margin="{StaticResource GapLeft12}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceCardTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Пока устройств нет — пустое состояние; живая карта стола появится вместе с устройствами -->
        <controls:EmptyState Icon="&#xE7F4;" Title="Устройств пока нет" Hint="Light Space найдёт ленты и клавиатуры в сети, по Bluetooth и USB. Найденные устройства появятся на карте стола, их можно будет собрать в группы." ActionText="Найти устройства" ActionIcon="&#xE721;" Command="{Binding FindDevicesCommand}"
                             Visibility="{Binding Devices.HasDevices, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

        <!-- Устройства есть: слева их живые цвета (карта стола появится позже), справа эффект, который на них играет -->
        <Grid DataContext="{Binding Scene}" Margin="{StaticResource PaddingPage}"
              Visibility="{Binding DataContext.Devices.HasDevices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource ScenePanelWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- Живые цвета устройств по группам: клик выбирает группу или устройство, Ctrl+клик и рамка мышью выделяют
                 несколько устройств -->
            <DockPanel d:DataContext="{d:DesignInstance vm:SceneViewModel}">
                <TextBlock DockPanel.Dock="Top" Text="Сцена" Style="{StaticResource PageTitle}"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="{StaticResource GapBottom8}"
                           Text="Ctrl+клик или рамка мышью выделяют несколько устройств — их можно сделать группой."/>
                <Grid>
                    <ScrollViewer x:Name="SceneScroll" VerticalScrollBarVisibility="Auto">
                        <!-- Пустое место под карточками тоже ловит мышь: с него начинается рамка выделения -->
                        <Grid x:Name="SceneArea" Background="Transparent"
                              MinHeight="{Binding ViewportHeight, ElementName=SceneScroll}"
                              PreviewMouseLeftButtonDown="OnAreaMouseDown" MouseMove="OnAreaMouseMove"
                              MouseLeftButtonUp="OnAreaMouseUp" LostMouseCapture="OnAreaLostMouseCapture">
                            <ItemsControl ItemsSource="{Binding Groups}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SceneGroupViewModel">
                                        <ContentControl Content="{Binding}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource GroupTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource SoloGroupTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SelectionBand" Style="{StaticResource SelectionBand}" Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- Выделено несколько устройств: всплывающая карточка с действием «Сделать группой» -->
                    <Border Style="{StaticResource FlyoutCard}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Visibility="{Binding CanMakeGroup, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Body}" VerticalAlignment="Center"
                                       Margin="{StaticResource PaddingMenuItem}"/>
                            <Button Style="{StaticResource AccentButton}" Content="Сделать группой" controls:Appearance.Icon="&#xE902;"
                                    Command="{Binding MakeGroupCommand}" Margin="{StaticResource GapRight4}"/>
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE711;" ToolTip="Снять выделение"
                                    Command="{Binding ClearSelectionCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Панель выбранной группы: название и цвет, сценарии, яркость, содержимое «По умолчанию», действия группы.
                 Пока ничего не выбрано — подсказка -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="{StaticResource GapLeft24}" d:DataContext="{d:DesignInstance vm:SceneViewModel}">
                <Grid>
                    <controls:EmptyState Icon="&#xE8B3;" Title="{Binding NoSelectionTitle}" Hint="{Binding NoSelectionHint}"
                                         Visibility="{Binding HasSelection, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <!-- Группа: своё название и цвет обводки -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsSolo, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                                <TextBox Tag="Название группы" Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Цвет обводки" Style="{StaticResource SectionLabel}"/>
                                <ListBox Style="{StaticResource SwatchPalette}" ItemsSource="{StaticResource GroupPalette}"
                                         SelectedItem="{Binding SelectedGroup.OutlineColor}"/>
                            </StackPanel>

                            <!-- Устройство без группы: его название вместо названия группы -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsSolo, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding SelectedGroup.Title}" Style="{StaticResource Subtitle}"/>
                                <TextBlock Text="Устройство без группы. Выделите его вместе с другими устройствами, чтобы сделать группу."
                                           Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
                            </StackPanel>

                            <!-- Сценарии группы по важности: строки перетаскиваются мышью, внизу всегда «По умолчанию» -->
                            <TextBlock Text="Сценарии" Style="{StaticResource SectionLabel}"/>
                            <ItemsControl ItemsSource="{Binding SelectedGroup.Scenarios}"
                                          controls:DragReorder.MoveCommand="{Binding MoveScenarioCommand}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ScenarioRowViewModel">
                                        <Border Style="{StaticResource ReorderRow}">
                                            <DockPanel VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE70F;"
                                                        ToolTip="Открыть сценарий" CommandParameter="{Binding}" Margin="{StaticResource GapLeft8}"
                                                        Command="{Binding DataContext.Scene.OpenScenarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="▶ играет" Style="{StaticResource PlayingMark}"
                                                           Visibility="{Binding IsPlaying, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ConditionText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Right" Text="▶ играет" Style="{StaticResource PlayingMark}"
                                               Visibility="{Binding SelectedGroup.IsDefaultPlaying, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                                    <TextBlock Text="По умолчанию" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Button Style="{StaticResource GhostButton}" Content="Сценарий" controls:Appearance.Icon="&#xE710;"
                                    HorizontalAlignment="Left" Command="{Binding AddScenarioCommand}"/>
                            <TextBlock Text="Играет верхний сценарий, у которого выполнено условие; перетащите строку, чтобы поменять важность."
                                       Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>

                            <controls:ValueSlider Label="Яркость группы" Unit="%" Minimum="0" Maximum="100" Step="1"
                                                  Value="{Binding SelectedGroup.Brightness}" Margin="{StaticResource GapTop16}"/>

                            <!-- Содержимое «По умолчанию»: галерея, ниже настройки выбранного эффекта -->
                            <TextBlock Text="По умолчанию" Style="{StaticResource SectionLabel}"/>
                            <views:EffectEditor DataContext="{Binding Editor}"/>

                            <!-- Устройства группы и действия с ней -->
                            <StackPanel Visibility="{Binding SelectedGroup.IsSolo, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="Устройства группы" Style="{StaticResource SectionLabel}"/>
                                <ItemsControl ItemsSource="{Binding SelectedGroup.Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:SceneDeviceViewModel">
                                            <Border Style="{StaticResource SettingRow}">
                                                <DockPanel VerticalAlignment="Center">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE738;"
                                                            ToolTip="Убрать из группы" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.Scene.RemoveFromGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource GhostButton}" Content="Разгруппировать" controls:Appearance.Icon="&#xE74D;"
                                        HorizontalAlignment="Left" Command="{Binding UngroupCommand}" Margin="{StaticResource GapTop8}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
