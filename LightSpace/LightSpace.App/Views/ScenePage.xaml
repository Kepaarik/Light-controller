<UserControl x:Class="LightSpace.App.Views.ScenePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Grid>
        <!-- Пока устройств нет — пустое состояние; живая карта стола появится вместе с устройствами -->
        <controls:EmptyState Icon="&#xE7F4;" Title="Устройств пока нет" Hint="Light Space найдёт ленты и клавиатуры в сети, по Bluetooth и USB. Найденные устройства появятся на карте стола, их можно будет собрать в группы." ActionText="Найти устройства" ActionIcon="&#xE721;" Command="{Binding FindDevicesCommand}"
                             Visibility="{Binding Devices.HasDevices, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

        <!-- Устройства уже есть, а карты стола ещё нет: цвет пока задаётся на вкладке «Устройства» -->
        <controls:EmptyState Icon="&#xE7F4;" Title="Карта стола скоро появится" Hint="Устройства найдены. Здесь они встанут на карту стола и соберутся в группы; цвет каждого устройства пока задаётся на вкладке «Устройства»." ActionText="Открыть устройства" ActionIcon="&#xE772;" Command="{Binding OpenDevicesCommand}"
                             Visibility="{Binding Devices.HasDevices, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
    </Grid>
</UserControl>
