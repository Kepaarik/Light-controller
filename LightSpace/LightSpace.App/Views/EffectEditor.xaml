<UserControl x:Class="LightSpace.App.Views.EffectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:views="clr-namespace:LightSpace.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:EffectEditorViewModel}">

    <!-- Содержимое-эффект: галерея плиток с живыми превью, ниже настройки выбранного эффекта.
         Один и тот же редактор правит «По умолчанию» группы на сцене и содержимое сценария -->
    <StackPanel>
        <TextBlock Text="{Binding SelectedTile.Description}" Style="{StaticResource Hint}"/>

        <ListBox Style="{StaticResource TileGallery}" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}"
                 Margin="{StaticResource GapTop16}"/>

        <!-- Настройки под галереей; страница устройства показывает их в боковой панели -->
        <views:EffectSettings Visibility="{Binding ShowsSettings, RelativeSource={RelativeSource AncestorType=views:EffectEditor}, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
    </StackPanel>
</UserControl>
