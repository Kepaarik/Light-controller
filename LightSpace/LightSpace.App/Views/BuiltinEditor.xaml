<UserControl x:Class="LightSpace.App.Views.BuiltinEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BuiltinEditorViewModel}">

    <!-- Содержимое — встроенный эффект: вместо превью подсказка, эффект устройства, скорость и цвет -->
    <StackPanel>
        <!-- Эффект играет само устройство, поэтому живого превью нет -->
        <Border Style="{StaticResource Card}" Margin="{StaticResource GapTop16}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Top" Margin="{StaticResource GapRight12}"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Встроенный эффект играет сам контроллер устройства, поэтому показать его здесь нельзя — посмотрите на само устройство. Приложение при этом ничего на устройство не отправляет."/>
            </DockPanel>
        </Border>

        <!-- Какой эффект играет каждое устройство; открытое в меню устройство — без своего названия.
             Варианты одного эффекта — одной строкой в списке, вариант выбирается ползунком -->
        <TextBlock Text="Устройства" Style="{StaticResource SectionLabel}"
                   Visibility="{Binding IsOneDevice, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>
        <ItemsControl ItemsSource="{Binding Devices}" Margin="{StaticResource GapTop8}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BuiltinDeviceViewModel">
                    <StackPanel>
                        <StackPanel Visibility="{Binding DataContext.IsOneDevice, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"/>
                            <TextBlock Text="{Binding Protocol}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <controls:SearchPicker ItemsSource="{Binding EffectGroups}" SelectedItem="{Binding SelectedGroup}"
                                               DisplayMemberPath="Title" Placeholder="Выберите эффект"
                                               Margin="{StaticResource GapTop8}"/>
                        <controls:ValueSlider Label="Вариант" Minimum="1" Maximum="{Binding VariantCount}" Step="1"
                                              Value="{Binding Variant}" Margin="{StaticResource GapTop8}"
                                              Visibility="{Binding HasVariants, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Сейчас не подключено ни одного устройства со встроенными эффектами. Они есть у лент ELK/MELK с известной моделью, подсветки Robobloq и клавиатуры RK S98 — найдите их на вкладке «Устройства»."
                   Style="{StaticResource Hint}"
                   Visibility="{Binding HasDevices, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

        <!-- Скорость; цвет — только у устройств, которые умеют играть эффект одним цветом -->
        <TextBlock Text="Скорость" Style="{StaticResource SectionLabel}"/>
        <controls:ValueSlider Label="Скорость эффекта" Unit="%" Minimum="0" Maximum="100" Step="5"
                              Value="{Binding Speed}"/>

        <StackPanel Visibility="{Binding IsColorShown, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="Цвета" Style="{StaticResource SectionLabel}"/>
            <DockPanel>
                <controls:ColorPicker DockPanel.Dock="Right" SelectedColor="{Binding Color}" VerticalAlignment="Center"
                                      Visibility="{Binding UseColor, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColors}"
                         HorizontalAlignment="Left"/>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
