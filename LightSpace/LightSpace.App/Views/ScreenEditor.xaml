<UserControl x:Class="LightSpace.App.Views.ScreenEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScreenEditorViewModel}">

    <!-- Содержимое-экран: живое превью картинки монитора, ниже монитор и настройки цветов -->
    <StackPanel>
        <Border Style="{StaticResource LivePreview}" Background="{Binding Preview}" Margin="{StaticResource GapTop16}"/>
        <TextBlock Text="Живое превью: так сценарий будет выглядеть, когда включится. Каждый светодиод берёт цвет экрана под своим местом на сцене."
                   Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>

        <TextBlock Text="Монитор" Style="{StaticResource SectionLabel}"/>
        <controls:SearchPicker ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                               OpenCommand="{Binding RefreshMonitorsCommand}" Placeholder="Выберите монитор"/>
        <Border Style="{StaticResource SettingRow}" Margin="{StaticResource GapTop8}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding KeepAspect}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Сохранять пропорции сцены" Style="{StaticResource Body}"/>
                    <TextBlock Text="Сцена не растягивается на экран, а берёт его середину; края экрана по длинной стороне не учитываются" Style="{StaticResource Hint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="Цвета" Style="{StaticResource SectionLabel}"/>
        <controls:ValueSlider Label="Насыщенность" Unit="%" Minimum="0" Maximum="200" Step="5"
                              Value="{Binding Saturation}" Margin="{StaticResource GapBottom16}"/>
        <controls:ValueSlider Label="Яркость" Unit="%" Minimum="10" Maximum="200" Step="5"
                              Value="{Binding Brightness}" Margin="{StaticResource GapBottom16}"/>
        <controls:ValueSlider Label="Сглаживание" Unit="%" Minimum="0" Maximum="95" Step="5"
                              Value="{Binding Smoothing}"/>
        <TextBlock Text="Сильное сглаживание делает смену цветов плавнее, но свет отстаёт от картинки."
                   Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"/>
    </StackPanel>
</UserControl>
