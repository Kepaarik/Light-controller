<UserControl x:Class="LightSpace.App.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:views="clr-namespace:LightSpace.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Grid Margin="{StaticResource PaddingPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и новый профиль из того, что играет сейчас -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" VerticalAlignment="Top"
                    Content="Сохранить текущую подсветку" controls:Appearance.Icon="&#xE74E;" Command="{Binding NewProfileCommand}"/>
            <StackPanel>
                <TextBlock Text="Профили" Style="{StaticResource PageTitle}" Margin="{StaticResource SpaceNone}"/>
                <TextBlock Text="Профиль запоминает, что играет на каждом устройстве и с какой яркостью. Применить его можно здесь или из меню значка в трее; устройства, которых в профиле нет, продолжают играть своё."
                           Style="{StaticResource Hint}" Margin="{StaticResource PageSubtitleMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left"/>
            </StackPanel>
        </DockPanel>

        <!-- Профилей нет: подсказка и сохранение -->
        <controls:EmptyState Grid.Row="1" Icon="&#xE728;" Title="Профилей пока нет"
                             Hint="Настройте эффекты и яркость на страницах устройств и сохраните их профилем — потом всё вернётся одним щелчком."
                             ActionText="Сохранить текущую подсветку" ActionIcon="&#xE74E;" Command="{Binding NewProfileCommand}"
                             Visibility="{Binding HasProfiles, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

        <!-- Профили строкой переключателей сверху, выбранный профиль под ними на всю ширину -->
        <Grid Grid.Row="1" Visibility="{Binding HasProfiles, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ProfileOption">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DevicesText}">
                            <TextBlock Text="{Binding Name}" MaxWidth="220" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <!-- Профиль, который сейчас играет -->
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Center"
                                       Margin="{StaticResource GapLeft8}" ToolTip="Сейчас играет этот профиль"
                                       Visibility="{Binding IsActive, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="1" Margin="{StaticResource GapTop16}">
                <controls:EmptyState Icon="&#xE728;" Title="Выберите профиль"
                                     Hint="Здесь будет видно, что он включает на каждом устройстве."
                                     Visibility="{Binding HasSelectedProfile, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelectedProfile, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                    <StackPanel DataContext="{Binding SelectedProfile}" d:DataContext="{d:DesignInstance vm:ProfileOption}">
                        <!-- Название и действия с профилем одной строкой -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="{StaticResource GapLeft16}">
                                    <Button Style="{StaticResource AccentButton}" Content="Применить" controls:Appearance.Icon="&#xE768;"
                                            Margin="{StaticResource GapWrap}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Записать текущую подсветку" controls:Appearance.Icon="&#xE72C;"
                                            Margin="{StaticResource GapWrap}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.UpdateProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Удалить" controls:Appearance.Icon="&#xE74D;"
                                            Margin="{StaticResource GapWrap}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </WrapPanel>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Text="{Binding Name}" KeyDown="OnNameKeyDown" ToolTip="Название профиля"/>
                                    <TextBlock Text="Сейчас играет этот профиль." Style="{StaticResource Hint}" Foreground="{DynamicResource SuccessBrush}"
                                               Margin="{StaticResource GapTop4}"
                                               Visibility="{Binding IsActive, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Устройства профиля: щелчок открывает настройки устройства в панели справа -->
                        <TextBlock Text="Устройства" Style="{StaticResource SectionLabel}"/>
                        <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Devices}" SelectedItem="{Binding EditedDevice}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:ProfileDeviceViewModel">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ContentText}">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   VerticalAlignment="Center" Margin="{StaticResource GapRight8}"/>
                                        <TextBlock x:Name="DeviceName" Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <!-- Забытое устройство приглушено -->
                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                            <Setter TargetName="DeviceName" Property="Opacity" Value="{StaticResource OpacityDisabled}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Слева сцена, справа панель: эффект сцены или настройки выбранного устройства -->
                        <Grid Margin="{StaticResource GapTop16}">
                            <Grid.ColumnDefinitions>
                                <!-- Обе колонки растут с окном: в панели справа больше плиток эффектов в ряд -->
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*" MinWidth="{StaticResource ProfilePanelMinWidth}"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <!-- Сцены ещё нет: что это и как собрать -->
                                <Border Style="{StaticResource Card}"
                                        Visibility="{Binding Scene.HasScene, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="Сцена" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Сцена объединяет устройства профиля: один эффект переходит с устройства на устройство по их местам на холсте или играет на всех синхронно. Устройства сцены играют её вместо своего эффекта."/>
                                        <Button Style="{StaticResource AccentButton}" Content="Собрать сцену" controls:Appearance.Icon="&#xE710;"
                                                HorizontalAlignment="Left" Margin="{StaticResource GapTop16}" Command="{Binding OpenSceneCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Сцена собрана: холст, место устройств, режим, направление и яркость -->
                                <Grid Visibility="{Binding IsSceneOpen, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                    <views:SceneEditor DataContext="{Binding Scene}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="{StaticResource GapLeft16}">
                                <!-- Ничего не выбрано: эффект сцены, а без сцены — подсказка -->
                                <StackPanel Visibility="{Binding HasEditedDevice, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                                    <Border Style="{StaticResource Card}"
                                            Visibility="{Binding Scene.HasScene, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock Text="Эффект сцены" Style="{StaticResource CardTitle}"/>

                                            <!-- У каких-то устройств свой эффект: одной кнопкой вся сцена играет эффект сцены -->
                                            <DockPanel Margin="{StaticResource GapBottom12}"
                                                       Visibility="{Binding Scene.HasOwnEffects, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                                <Button DockPanel.Dock="Right" Content="Всем устройствам" controls:Appearance.Icon="&#xE8B3;"
                                                        VerticalAlignment="Center" Margin="{StaticResource GapLeft12}"
                                                        ToolTip="Выключить свой эффект у всех устройств сцены" Command="{Binding Scene.PlaySceneEffectEverywhereCommand}"/>
                                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                           Text="У некоторых устройств свой эффект — они играют его, а не эффект сцены."/>
                                            </DockPanel>

                                            <views:EffectEditor DataContext="{Binding Scene.Editor}" ShowsSettings="{Binding IsPlaying}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}"
                                            Visibility="{Binding Scene.HasScene, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Выберите устройство выше — здесь появятся его яркость и эффект в профиле."/>
                                    </Border>
                                </StackPanel>

                                <!-- Устройство: яркость, место в сцене и эффект — всё про него здесь -->
                                <StackPanel Visibility="{Binding HasEditedDevice, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE711;"
                                                        ToolTip="Закрыть — справа снова эффект сцены" VerticalAlignment="Center" Margin="{StaticResource GapLeft8}"
                                                        Command="{Binding CloseDeviceCommand}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE74D;"
                                                        ToolTip="Убрать из профиля" VerticalAlignment="Center" Command="{Binding EditedDevice.RemoveCommand}"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding EditedDevice.Icon}" Style="{StaticResource Icon}"
                                                           FontSize="24" Width="32" Margin="{StaticResource GapRight12}" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EditedDevice.Name}" Style="{StaticResource CardTitle}" Margin="{StaticResource SpaceNone}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EditedDevice.ContentText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <controls:ValueSlider Label="Яркость" Unit="%" Minimum="0" Maximum="100" Step="1"
                                                                  Value="{Binding EditedDevice.Brightness}" Margin="{StaticResource GapTop16}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Эффект устройства в сцене: галерея и встроенные эффекты видны сразу, выбор в них включает свой эффект -->
                                    <StackPanel Visibility="{Binding IsEditedInScene, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                        <TextBlock Text="Эффект" Style="{StaticResource SectionLabel}"/>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <CheckBox Content="Свой эффект" IsChecked="{Binding EditedSceneDevice.HasOwnEffect}" HorizontalAlignment="Left"/>
                                                <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"
                                                           Text="Выключено — устройство играет эффект сцены. Выберите эффект ниже, и устройство заиграет его вместо эффекта сцены."/>
                                                <views:DeviceContentEditor DataContext="{Binding EditedSceneDevice.Content}" Margin="{StaticResource GapTop16}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Место устройства в сцене: играет ли оно её, вид и яркость в сцене -->
                                    <StackPanel Visibility="{Binding Scene.HasScene, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                        <TextBlock Text="В сцене" Style="{StaticResource SectionLabel}"/>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <CheckBox Content="Играет сцену" IsChecked="{Binding EditedMember.IsIncluded}" HorizontalAlignment="Left"
                                                          Visibility="{Binding HasEditedMember, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                                                <TextBlock Style="{StaticResource Hint}"
                                                           Visibility="{Binding HasEditedMember, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}"
                                                           Text="Устройство сейчас не найдено — взять его в сцену можно, когда оно подключится."/>

                                                <StackPanel Visibility="{Binding IsEditedInScene, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="Вид" Style="{StaticResource Hint}" Margin="{StaticResource GapTop16}"/>
                                                    <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding EditedSceneDevice.Shapes}"
                                                             SelectedItem="{Binding EditedSceneDevice.SelectedShape}" Margin="{StaticResource GapTop4}"/>
                                                    <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapTop4}"
                                                               Text="Вид — как устройство выглядит на самом деле: эффект сцены ложится на его светодиоды так, как они стоят в этом виде."/>

                                                    <controls:ValueSlider Label="Шестигранников" Minimum="1" Maximum="30" Step="1"
                                                                          Value="{Binding EditedSceneDevice.Panels}" Margin="{StaticResource GapTop16}"
                                                                          Visibility="{Binding EditedSceneDevice.IsHexagons, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                                                    <controls:ValueSlider Label="Яркость в сцене" Unit="%" Minimum="0" Maximum="100" Step="1"
                                                                          Value="{Binding EditedSceneDevice.Brightness}" Margin="{StaticResource GapTop16}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Эффект устройства вне сцены: встроенные эффекты и галерея; правят профиль -->
                                    <StackPanel Visibility="{Binding IsEditedInScene, Converter={x:Static controls:InverseBooleanToVisibilityConverter.Instance}}">
                                        <TextBlock Style="{StaticResource SectionLabel}">
                                            <Run Text="Эффект в профиле:"/> <Run Text="{Binding EditedDevice.Name, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Border Style="{StaticResource Card}">
                                            <views:DeviceContentEditor DataContext="{Binding Content}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
