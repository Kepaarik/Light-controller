<UserControl x:Class="LightSpace.App.Views.BuiltinSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BuiltinEditorViewModel}">

    <!-- Настройки встроенного эффекта открытого устройства в боковой панели: вариант, скорость и цвет -->
    <StackPanel>
        <TextBlock Text="{Binding SelectedTile.Title}" Style="{StaticResource SectionLabel}"/>

        <!-- Эффект играет само устройство, поэтому живого превью нет -->
        <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapBottom16}"
                   Text="Встроенный эффект играет сам контроллер устройства — посмотрите на само устройство."/>

        <!-- Пресеты — варианты эффекта: у контроллера они идут под соседними номерами и отличаются цветами и рисунком -->
        <StackPanel Margin="{StaticResource GapBottom16}"
                    Visibility="{Binding Device.HasVariants, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="Пресет" Style="{StaticResource Body}" Margin="{StaticResource GapBottom8}"/>
            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Device.Presets}" SelectedItem="{Binding Device.SelectedPreset}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>

        <controls:ValueSlider Label="Скорость эффекта" Unit="%" Minimum="0" Maximum="100" Step="1"
                              Value="{Binding Speed}"/>

        <!-- Цвет — только у устройств, которые умеют играть эффект одним цветом -->
        <StackPanel Visibility="{Binding IsColorShown, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="Цвета" Style="{StaticResource SectionLabel}"/>
            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColors}"
                     HorizontalAlignment="Left"/>
            <DockPanel Margin="{StaticResource GapTop8}"
                       Visibility="{Binding UseColor, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <controls:ColorPicker DockPanel.Dock="Right" SelectedColor="{Binding Color}"/>
                <TextBlock Text="Цвет" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Готовые цвета: круглые образцы, щелчок сразу ставит цвет -->
            <ItemsControl ItemsSource="{Binding ColorPresets}" Margin="{StaticResource GapTop8}"
                          Visibility="{Binding UseColor, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Margin="0,0,6,6" ToolTip="{Binding Title}"
                                Command="{Binding DataContext.ApplyColorPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Swatch}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
