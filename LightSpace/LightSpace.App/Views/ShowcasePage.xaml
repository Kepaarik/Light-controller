<UserControl x:Class="LightSpace.App.Views.ShowcasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             xmlns:rk="clr-namespace:LightSpace.Devices.RoyalKludge;assembly=LightSpace.Devices"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ShowcaseViewModel}">

    <!-- Витрина компонентов (только отладочная сборка): все компоненты во всех состояниях и переключатель темы.
         Наведение и нажатие показаны принудительно через Appearance.ForceHover и Appearance.ForcePressed -->
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource GapRight12}"/>
            <Setter Property="MinWidth" Value="{StaticResource TileWidth}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PaddingPage}">
            <TextBlock Text="Витрина" Style="{StaticResource PageTitle}"/>

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                <TextBlock Text="Тема" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="{StaticResource GapRight12}"/>
                <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/>
            </DockPanel>

            <!-- Кнопки -->
            <TextBlock Text="Кнопки" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Accent" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource AccentButton}" Content="Найти устройства"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource AccentButton}" Content="Найти устройства" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource AccentButton}" Content="Найти устройства" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource AccentButton}" Content="Найти устройства" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Обычная" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Обзор…"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Обзор…" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Обзор…" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Обзор…" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Ghost" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource GhostButton}" Content="Отмена"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Danger" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource DangerButton}" Content="Удалить"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource DangerButton}" Content="Удалить" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource DangerButton}" Content="Удалить" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource DangerButton}" Content="Удалить" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Со значком" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Добавить сценарий" controls:Appearance.Icon="&#xE710;"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Добавить сценарий" controls:Appearance.Icon="&#xE710;" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Добавить сценарий" controls:Appearance.Icon="&#xE710;" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Content="Добавить сценарий" controls:Appearance.Icon="&#xE710;" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Иконка" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE713;" ToolTip="Настройки"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE713;" ToolTip="Настройки" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE713;" ToolTip="Настройки" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE713;" ToolTip="Настройки" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Пункт меню" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource MenuButton}" Width="200" Content="Открыть Light Space" controls:Appearance.Icon="&#xE8A7;"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource MenuButton}" Width="200" Content="Открыть Light Space" controls:Appearance.Icon="&#xE8A7;" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource MenuButton}" Width="200" Content="Открыть Light Space" controls:Appearance.Icon="&#xE8A7;" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Button Style="{StaticResource MenuButton}" Width="200" Content="Открыть Light Space" controls:Appearance.Icon="&#xE8A7;" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Кнопка-переключатель" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Content="Закрепить"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Content="Закрепить" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Content="Закрепить" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Content="Закрепить" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Content="Закрепить" IsChecked="True"/>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Ввод -->
            <TextBlock Text="Ввод" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Тумблер" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Content="Подсветка"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Content="Подсветка" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Content="Подсветка" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Content="Подсветка" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Content="Подсветка" IsChecked="True"/>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Content="Подсветка" IsChecked="True" IsEnabled="False"/>
                            <TextBlock Text="Выбрано, выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Чип" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Style="{StaticResource Chip}" Content="Стол"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Style="{StaticResource Chip}" Content="Стол" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Style="{StaticResource Chip}" Content="Стол" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Style="{StaticResource Chip}" Content="Стол" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <CheckBox Style="{StaticResource Chip}" Content="Стол" IsChecked="True"/>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Сегмент (одиночный)" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <RadioButton GroupName="Demo0" Content="В фокусе"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <RadioButton GroupName="Demo1" Content="В фокусе" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <RadioButton GroupName="Demo2" Content="В фокусе" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <RadioButton GroupName="Demo3" Content="В фокусе" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <RadioButton GroupName="DemoChecked" Content="Запущен" IsChecked="True"/>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Поле с плавающей подписью" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Tag="Название" Width="220"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Tag="Название" Width="220" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Tag="Название" Width="220" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Tag="Название" Width="220" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Tag="Название" Width="220" Text="{Binding FieldText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="С текстом" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Поле поиска" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Style="{StaticResource SearchField}" Tag="Поиск приложений" Width="220"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Style="{StaticResource SearchField}" Tag="Поиск приложений" Width="220" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Style="{StaticResource SearchField}" Tag="Поиск приложений" Width="220" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <TextBox Style="{StaticResource SearchField}" Tag="Поиск приложений" Width="220" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Кнопка выпадающей панели" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Style="{StaticResource PickerButton}" Content="Выберите приложение" Width="220"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Style="{StaticResource PickerButton}" Content="Выберите приложение" Width="220" controls:Appearance.ForceHover="True"/>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Style="{StaticResource PickerButton}" Content="Выберите приложение" Width="220" controls:Appearance.ForcePressed="True"/>
                            <TextBlock Text="Нажатие" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Style="{StaticResource PickerButton}" Content="Выберите приложение" Width="220" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <ToggleButton Style="{StaticResource PickerButton}" Content="Выберите приложение" Width="220" IsChecked="True"/>
                            <TextBlock Text="Открыта" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Выпадающая панель-карточка с поиском" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <controls:SearchPicker Width="280" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                                               Placeholder="Выберите приложение" Margin="{StaticResource GapRight12}"/>
                        <controls:SearchPicker Width="280" ItemsSource="{Binding Apps}" Placeholder="Ничего не выбрано"
                                               Margin="{StaticResource GapRight12}"/>
                        <controls:SearchPicker Width="280" ItemsSource="{Binding Apps}" Placeholder="Выключено" IsEnabled="False"/>
                    </WrapPanel>

                    <TextBlock Text="Выбор приложения со значками" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}">
                            <controls:SearchPicker Width="280" ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedAppOption}"
                                                   ItemTemplate="{StaticResource AppOptionTemplate}" Placeholder="Выберите приложение"/>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <controls:SearchPicker Width="280" ItemsSource="{Binding AppOptions}" ItemTemplate="{StaticResource AppOptionTemplate}"
                                                   Placeholder="Выберите приложение"/>
                            <TextBlock Text="Ничего не выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <controls:SearchPicker Width="280" ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedAppOption}"
                                                   ItemTemplate="{StaticResource AppOptionTemplate}" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <Border Style="{StaticResource FlyoutCard}" Width="280" Margin="{StaticResource SpaceNone}">
                                <ListBox ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedAppOption}"
                                         ItemTemplate="{StaticResource AppOptionTemplate}" Margin="{StaticResource Space4}"/>
                            </Border>
                            <TextBlock Text="Список в открытой панели" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Ползунок с подписью значения" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <controls:ValueSlider Width="280" Label="Яркость" Unit="%" Minimum="0" Maximum="100" Step="1"
                                              Value="{Binding Brightness}" Margin="{StaticResource GapRight12}"/>
                        <controls:ValueSlider Width="280" Label="Своя заливка" Unit="%" Minimum="0" Maximum="100" Step="5"
                                              Value="{Binding Brightness}" Fill="{Binding ColorBrush}" Margin="{StaticResource GapRight12}"/>
                        <controls:ValueSlider Width="280" Label="Выключено" Unit="мс" Minimum="0" Maximum="2000" Step="50"
                                              Value="400" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Выбор из набора -->
            <TextBlock Text="Выбор из набора" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Сегменты" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}"
                                 Margin="{StaticResource GapRight12}"/>
                        <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Segments}" SelectedIndex="0" IsEnabled="False"/>
                    </WrapPanel>

                    <TextBlock Text="Сегменты с недоступными вариантами" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding ContentKinds}" SelectedItem="{Binding SelectedContentKind}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentItem}">
                                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </WrapPanel>

                    <TextBlock Text="Плитки-галерея" Style="{StaticResource CardTitle}"/>
                    <ListBox Style="{StaticResource TileGallery}" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}"
                             Margin="{StaticResource GapBottom16}"/>

                    <TextBlock Text="Палитра цветов групп" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <ListBox Style="{StaticResource SwatchPalette}" ItemsSource="{StaticResource GroupPalette}" SelectedIndex="1"
                                 Margin="{StaticResource GapRight12}"/>
                        <ListBox Style="{StaticResource SwatchPalette}" ItemsSource="{StaticResource GroupPalette}" SelectedIndex="1"
                                 IsEnabled="False"/>
                    </WrapPanel>

                    <TextBlock Text="Список" Style="{StaticResource CardTitle}"/>
                    <ListBox ItemsSource="{Binding Apps}" SelectedIndex="1" MaxHeight="160" Width="320" HorizontalAlignment="Left"
                             Margin="{StaticResource GapBottom16}"/>
                </StackPanel>
            </Border>

            <!-- Всплывающие карточки -->
            <TextBlock Text="Всплывающие карточки" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <Button Content="Подсказка (наведите)" ToolTip="Подсказка — своя карточка, а не системная" Margin="{StaticResource GapRight12}"/>
                    <Button Content="Контекстное меню (правый клик)" Margin="{StaticResource GapRight12}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Переименовать" Icon="&#xE8AC;" InputGestureText="F2"/>
                                <MenuItem Header="Закрепить" IsCheckable="True" IsChecked="True"/>
                                <MenuItem Header="Переместить в группу">
                                    <MenuItem Header="Стол"/>
                                    <MenuItem Header="Полка"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Недоступно" IsEnabled="False"/>
                                <MenuItem Header="Удалить" Icon="&#xE74D;" InputGestureText="Del"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Модальная карточка" Command="{Binding ShowDialogCommand}" Margin="{StaticResource GapRight12}"/>
                    <Button Content="Опасное подтверждение" Command="{Binding ShowDangerDialogCommand}" Margin="{StaticResource GapRight12}"/>
                    <Button Content="Карточка с опцией" Command="{Binding ShowOptionDialogCommand}" Margin="{StaticResource GapRight12}"/>
                    <Button Content="Сообщение" Command="{Binding ShowMessageCommand}"/>
                </WrapPanel>
            </Border>

            <!-- Выбор цвета -->
            <TextBlock Text="Выбор цвета" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:ColorWheel Width="{StaticResource ColorWheelSize}" Height="{StaticResource ColorWheelSize}"
                                             SelectedColor="{Binding Color}"/>
                        <StackPanel VerticalAlignment="Center" Margin="{StaticResource Space24}">
                            <Border Width="{StaticResource FieldHeight}" Height="{StaticResource FieldHeight}" CornerRadius="{StaticResource RadiusControl}"
                                    Background="{Binding ColorBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="{StaticResource StrokeThin}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding ColorHex}" Style="{StaticResource BodyStrong}" Margin="{StaticResource GapTop8}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Тот же цвет в одну строку: кнопка с образцом открывает карточку с кругом -->
                    <TextBlock Text="Кнопка выбора цвета" Style="{StaticResource CardTitle}" Margin="{StaticResource GapTop16}"/>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <controls:ColorPicker SelectedColor="{Binding Color}" HorizontalAlignment="Left"/>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}">
                            <controls:ColorPicker SelectedColor="{Binding Color}" HorizontalAlignment="Left" IsEnabled="False"/>
                            <TextBlock Text="Выключено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Раскладка клавиатуры -->
            <TextBlock Text="Раскладка клавиатуры" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <controls:KeyboardLayout Keys="{x:Static rk:RkS98Layout.Keys}"/>
                </Viewbox>
            </Border>

            <!-- Живые цвета устройств на сцене: кадр эффекта тем же рендером, что уходит на устройства -->
            <TextBlock Text="Живые цвета устройств" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Полоса ленты" Style="{StaticResource CardTitle}"/>
                    <Border Height="{StaticResource LedBarHeight}" CornerRadius="{StaticResource RadiusSmall}"
                            Background="{Binding StripColors}" BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="{StaticResource StrokeThin}" Margin="{StaticResource GapBottom16}"/>

                    <TextBlock Text="Живое превью сценария" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource LivePreview}" Background="{Binding Tiles[4].Preview}"/>
                            <TextBlock Text="С кадром эффекта" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource LivePreview}"/>
                            <TextBlock Text="Без кадра" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Клавиатура с цветами клавиш" Style="{StaticResource CardTitle}"/>
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <controls:KeyboardLayout Keys="{x:Static rk:RkS98Layout.Keys}" Colors="{Binding KeyboardColors}"/>
                    </Viewbox>
                </StackPanel>
            </Border>

            <!-- Сцена: карточки устройств, рамки групп, сценарии группы, действие с выделением и рамка выделения мышью -->
            <TextBlock Text="Сцена: группы и выделение" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Карточка устройства" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource DeviceCard}">
                                <StackPanel>
                                    <TextBlock Text="Полка" Style="{StaticResource BodyStrong}"/>
                                    <Border Height="{StaticResource LedBarHeight}" CornerRadius="{StaticResource RadiusSmall}"
                                            Background="{Binding StripColors}" Margin="{StaticResource GapTop8}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource DeviceCard}" controls:Appearance.ForceHover="True">
                                <StackPanel>
                                    <TextBlock Text="Полка" Style="{StaticResource BodyStrong}"/>
                                    <Border Height="{StaticResource LedBarHeight}" CornerRadius="{StaticResource RadiusSmall}"
                                            Background="{Binding StripColors}" Margin="{StaticResource GapTop8}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource DeviceCard}" controls:Appearance.IsSelected="True">
                                <StackPanel>
                                    <TextBlock Text="Полка" Style="{StaticResource BodyStrong}"/>
                                    <Border Height="{StaticResource LedBarHeight}" CornerRadius="{StaticResource RadiusSmall}"
                                            Background="{Binding StripColors}" Margin="{StaticResource GapTop8}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Выделено" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Группа" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource GroupFrame}">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding [0], Source={StaticResource GroupPalette}}"/>
                                </Border.BorderBrush>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource GroupFrameHeader}">
                                        <TextBlock DockPanel.Dock="Right" Text="▶ По умолчанию" Style="{StaticResource PlayingMark}"/>
                                        <TextBlock Text="Стол" Style="{StaticResource BodyStrong}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource DeviceCard}">
                                        <TextBlock Text="Лента за монитором" Style="{StaticResource BodyStrong}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource GroupFrame}" controls:Appearance.IsSelected="True">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding [1], Source={StaticResource GroupPalette}}"/>
                                </Border.BorderBrush>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource GroupFrameHeader}">
                                        <TextBlock DockPanel.Dock="Right" Text="▶ По умолчанию" Style="{StaticResource PlayingMark}"/>
                                        <TextBlock Text="Полки" Style="{StaticResource BodyStrong}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource DeviceCard}">
                                        <TextBlock Text="Верхняя полка" Style="{StaticResource BodyStrong}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Сценарии группы: перетаскиваемый список" Style="{StaticResource CardTitle}"/>
                    <WrapPanel Margin="{StaticResource GapBottom16}">
                        <!-- Живой список: строки переставляются мышью, внизу всегда «По умолчанию» -->
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <ItemsControl ItemsSource="{Binding ReorderSamples}" controls:DragReorder.MoveCommand="{Binding MoveSampleCommand}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:ReorderSample">
                                        <Border Style="{StaticResource ReorderRow}">
                                            <DockPanel VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="▶ играет" Style="{StaticResource PlayingMark}"
                                                           Visibility="{Binding IsPlaying, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"/>
                                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource SettingRow}">
                                <TextBlock Text="По умолчанию" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Content="Сценарий" controls:Appearance.Icon="&#xE710;"
                                    HorizontalAlignment="Left"/>
                            <TextBlock Text="Обычное (тяните строки мышью)" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource ReorderRow}" controls:Appearance.ForceHover="True">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                    <StackPanel>
                                        <TextBlock Text="Музыка" Style="{StaticResource Body}"/>
                                        <TextBlock Text="Spotify.exe · запущен" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Наведение" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource ReorderRow}" controls:DragReorder.IsDragging="True">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                    <StackPanel>
                                        <TextBlock Text="Музыка" Style="{StaticResource Body}"/>
                                        <TextBlock Text="Spotify.exe · запущен" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Перетаскивается" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Right" Text="▶ играет" Style="{StaticResource PlayingMark}"/>
                                    <TextBlock Text="По умолчанию" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="«По умолчанию» играет" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Действие с выделением и рамка выделения" Style="{StaticResource CardTitle}"/>
                    <WrapPanel>
                        <Border Style="{StaticResource FlyoutCard}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Выбрано 2 устройства" Style="{StaticResource Body}" VerticalAlignment="Center"
                                           Margin="{StaticResource PaddingMenuItem}"/>
                                <Button Style="{StaticResource AccentButton}" Content="Сделать группой" controls:Appearance.Icon="&#xE902;"
                                        Margin="{StaticResource GapRight4}"/>
                                <Button Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE711;" ToolTip="Снять выделение"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SelectionBand}" Width="{StaticResource TileWidth}" Height="{StaticResource TilePreviewHeight}"
                                Margin="{StaticResource ShadowRoom}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Карта сцены: подложка-стол, устройства на своих местах, рамка группы с подписью, границы слоёв, список слоёв -->
            <TextBlock Text="Карта сцены и слои" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Карта: устройства и группа" Style="{StaticResource CardTitle}"/>
                    <Grid Height="{StaticResource SceneEditorHeight}" Margin="{StaticResource SceneMapMargin}">
                        <controls:SceneMap>
                            <Border Style="{StaticResource SceneSurface}" controls:SceneMap.Place="{x:Static controls:SceneMap.WholeScene}"/>

                            <!-- Рамка группы, подпись над ней -->
                            <Grid controls:SceneMap.Place="14,10,172,14">
                                <Border Style="{StaticResource MapGroupFrame}">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding [0], Source={StaticResource GroupPalette}}"/>
                                    </Border.BorderBrush>
                                </Border>
                                <Canvas VerticalAlignment="Top" Height="0">
                                    <TextBlock Canvas.Bottom="0" Text="Стол  ▶ По умолчанию" Style="{StaticResource MapLabel}"/>
                                </Canvas>
                            </Grid>

                            <!-- Ленты: обычная, выбранная; вертикальная — под курсором в режиме перетаскивания -->
                            <Border Style="{StaticResource SceneDevice}" controls:SceneMap.Place="20,15,75,4" Background="{Binding StripColors}"/>
                            <Border Style="{StaticResource SceneDevice}" controls:SceneMap.Place="105,15,75,4" Background="{Binding StripColors}"
                                    controls:Appearance.IsSelected="True"/>
                            <Border Style="{StaticResource SceneDevice}" controls:SceneMap.Place="-12,68,60,4" controls:SceneMap.Angle="90"
                                    Background="{Binding StripColors}" controls:Appearance.IsMovable="True" controls:Appearance.ForceHover="True"/>

                            <!-- Клавиатура с цветами клавиш и устройство одного цвета -->
                            <Border Style="{StaticResource SceneDevice}" controls:SceneMap.Place="62,62,76,28">
                                <Viewbox Stretch="Fill">
                                    <controls:KeyboardLayout Keys="{x:Static rk:RkS98Layout.Keys}" Colors="{Binding KeyboardColors}"/>
                                </Viewbox>
                            </Border>
                            <Border Style="{StaticResource SceneDevice}" controls:SceneMap.Place="170,80,12,12" CornerRadius="{StaticResource RadiusPill}"
                                    Background="{Binding ColorBrush}"/>
                        </controls:SceneMap>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapTop8}"
                               Text="Рамка группы с подписью; ленты: обычная, выбранная и вертикальная под курсором в режиме перетаскивания; клавиатура; устройство одного цвета."/>

                    <TextBlock Text="Холст слоёв" Style="{StaticResource CardTitle}" Margin="{StaticResource GapTop16}"/>
                    <Grid Height="{StaticResource SceneEditorHeight}">
                        <controls:SceneMap>
                            <!-- Подложка показывает кадр всей сцены -->
                            <Border Style="{StaticResource SceneSurface}" controls:SceneMap.Place="{x:Static controls:SceneMap.WholeScene}"
                                    Background="{Binding Tiles[4].Preview}"/>

                            <Grid controls:SceneMap.Place="10,10,80,45">
                                <Rectangle Style="{StaticResource LayerBounds}"/>
                                <Border Style="{StaticResource LayerTag}">
                                    <TextBlock Text="Обычное" Style="{StaticResource Caption}"/>
                                </Border>
                            </Grid>
                            <Grid controls:SceneMap.Place="110,10,80,45">
                                <Rectangle Style="{StaticResource LayerBounds}" controls:Appearance.ForceHover="True"/>
                                <Border Style="{StaticResource LayerTag}">
                                    <TextBlock Text="Наведение" Style="{StaticResource Caption}"/>
                                </Border>
                            </Grid>
                            <Grid controls:SceneMap.Place="10,65,80,45">
                                <Rectangle Style="{StaticResource LayerBounds}" controls:Appearance.IsSelected="True"/>
                                <Border Style="{StaticResource LayerTag}">
                                    <TextBlock Text="Выбрано" Style="{StaticResource Caption}"/>
                                </Border>
                                <Border Style="{StaticResource LayerHandle}"/>
                            </Grid>
                            <Grid controls:SceneMap.Place="110,65,80,45" Opacity="{StaticResource OpacityDisabled}">
                                <Rectangle Style="{StaticResource LayerBounds}"/>
                                <Border Style="{StaticResource LayerTag}">
                                    <TextBlock Text="Скрыто" Style="{StaticResource Caption}"/>
                                </Border>
                            </Grid>
                        </controls:SceneMap>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="{StaticResource GapTop8}"
                               Text="Границы слоя: обычные, под курсором, выбранные с ручкой размера в правом нижнем углу, скрытый слой."/>

                    <TextBlock Text="Строки списка слоёв" Style="{StaticResource CardTitle}" Margin="{StaticResource GapTop16}"/>
                    <WrapPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource ReorderRow}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE74D;" ToolTip="Удалить слой"/>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="True" ToolTip="Слой виден" Margin="{StaticResource GapRight8}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Радуга" Style="{StaticResource Body}"/>
                                        <TextBlock Text="Обычное · 100 %" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Обычное" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource ReorderRow}" controls:Appearance.IsSelected="True">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE74D;" ToolTip="Удалить слой"/>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="True" ToolTip="Слой виден" Margin="{StaticResource GapRight8}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Пламя" Style="{StaticResource Body}"/>
                                        <TextBlock Text="Сложение · 60 %" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Выбрано" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Cell}" Width="{StaticResource PickerMinWidth}">
                            <Border Style="{StaticResource ReorderRow}">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GripIcon}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE74D;" ToolTip="Удалить слой"/>
                                    <CheckBox DockPanel.Dock="Right" ToolTip="Слой виден" Margin="{StaticResource GapRight8}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Звёзды" Style="{StaticResource Body}"/>
                                        <TextBlock Text="Светлее · 100 %" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Скрытый слой" Style="{StaticResource Caption}" Margin="{StaticResource GapTop4}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Текст и поверхности -->
            <TextBlock Text="Текст и поверхности" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Заголовок страницы" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Заголовок" Style="{StaticResource Title}"/>
                    <TextBlock Text="Подзаголовок" Style="{StaticResource Subtitle}"/>
                    <TextBlock Text="Основной текст" Style="{StaticResource Body}"/>
                    <TextBlock Text="Основной текст, полужирный" Style="{StaticResource BodyStrong}"/>
                    <TextBlock Text="Пояснение под настройкой" Style="{StaticResource Hint}"/>
                    <TextBlock Text="Предупреждение" Style="{StaticResource Warning}"/>
                    <Border Style="{StaticResource Divider}"/>
                    <WrapPanel Margin="{StaticResource GapTop8}">
                        <Border Style="{StaticResource FlyoutCard}">
                            <TextBlock Text="Всплывающая карточка" Margin="{StaticResource PaddingMenuItem}"/>
                        </Border>
                        <Border Style="{StaticResource DialogCard}" Margin="{StaticResource ShadowRoom}">
                            <TextBlock Text="Модальная карточка" Style="{StaticResource Subtitle}"/>
                        </Border>
                        <StackPanel Margin="{StaticResource ShadowRoom}">
                            <TextBlock Text="Состояния" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Успех" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="Предупреждение" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="Ошибка" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Информация" Foreground="{DynamicResource InfoBrush}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Пустое состояние -->
            <TextBlock Text="Пустое состояние" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}">
                <controls:EmptyState Icon="&#xE7F4;" Title="Устройств пока нет" Hint="Подсказка, что здесь появится и как этого добиться."
                                     ActionText="Найти устройства" ActionIcon="&#xE721;"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
