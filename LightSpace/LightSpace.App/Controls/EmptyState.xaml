<UserControl x:Class="LightSpace.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             x:Name="Root"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <!-- Пустое состояние страницы: большой значок, заголовок, пояснение и главное действие -->
    <StackPanel MaxWidth="{StaticResource EmptyStateMaxWidth}">
        <TextBlock Text="{Binding Icon, ElementName=Root}" Style="{StaticResource Icon}" FontSize="{StaticResource FontSizeIconLarge}"
                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="{StaticResource GapBottom16}"/>
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Subtitle}" TextAlignment="Center"
                   Margin="{StaticResource GapBottom8}"/>
        <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource Hint}" TextAlignment="Center"/>
        <Button x:Name="ActionButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="{StaticResource GapTop16}"
                Content="{Binding ActionText, ElementName=Root}" Command="{Binding Command, ElementName=Root}"
                controls:Appearance.Icon="{Binding ActionIcon, ElementName=Root}"/>
    </StackPanel>
</UserControl>
