<UserControl x:Class="LightSpace.App.Controls.ValueSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Подпись слева, значение с единицей справа, под ними ползунок с цветной заливкой.
         Диапазон и значение передаются ползунку из кода: иначе он успел бы обрезать значение по своему диапазону по умолчанию -->
    <StackPanel>
        <DockPanel Margin="{StaticResource GapBottom4}">
            <TextBlock x:Name="ValueLabel" DockPanel.Dock="Right" Style="{StaticResource BodyStrong}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Slider x:Name="Inner" IsSnapToTickEnabled="True" ValueChanged="OnInnerValueChanged"/>
    </StackPanel>
</UserControl>
