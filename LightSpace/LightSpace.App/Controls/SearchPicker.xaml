<UserControl x:Class="LightSpace.App.Controls.SearchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LightSpace.App.Controls"
             x:Name="Root"
             MinWidth="{StaticResource PickerMinWidth}">

    <!-- Замена ComboBox для длинных списков: кнопка-поле открывает карточку с поиском и списком -->
    <Grid>
        <!-- Пока панель открыта, кнопка не ловит клик: иначе он закрыл бы панель и тут же открыл её снова -->
        <ToggleButton x:Name="Opener" Style="{StaticResource PickerButton}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Flyout, Converter={x:Static controls:InverseBooleanConverter.Instance}}">
            <Grid>
                <TextBlock x:Name="SelectionText" TextTrimming="CharacterEllipsis"/>
                <!-- С шаблоном вариантов выбранный вариант на кнопке выглядит так же, как в списке -->
                <ContentPresenter x:Name="SelectionContent" Visibility="Collapsed"/>
            </Grid>
        </ToggleButton>

        <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=Opener}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False"
               IsOpen="{Binding IsChecked, ElementName=Opener, Mode=TwoWay}"
               Opened="OnFlyoutOpened">
            <Border Style="{StaticResource FlyoutCard}" MinWidth="{Binding ActualWidth, ElementName=Opener}">
                <StackPanel>
                    <TextBox x:Name="Search" Style="{StaticResource SearchField}" Tag="Поиск" Margin="{StaticResource Space4}"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>
                    <ListBox x:Name="Items" MaxHeight="{StaticResource PickerListMaxHeight}" Margin="{StaticResource Space4}"
                             SelectionChanged="OnItemSelected" KeyDown="OnListKeyDown"/>
                    <TextBlock x:Name="NothingFound" Text="Ничего не найдено" Style="{StaticResource Hint}"
                               Margin="{StaticResource PaddingMenuItem}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
