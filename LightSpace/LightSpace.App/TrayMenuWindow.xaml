<Window x:Class="LightSpace.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
        xmlns:controls="clr-namespace:LightSpace.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Light Space"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontText}"
        FontSize="{StaticResource FontSizeBody}">

    <!-- Меню трея — своя карточка в стиле приложения, а не системное меню -->
    <Border Style="{StaticResource FlyoutCard}" MinWidth="{StaticResource FlyoutMinWidth}">
        <StackPanel>
            <!-- Шапка: значок, название и сколько устройств на связи -->
            <DockPanel Margin="{StaticResource PaddingMenuItem}">
                <Image DockPanel.Dock="Left" Source="Assets/LightSpace.ico" Width="20" Height="20" VerticalAlignment="Center"/>
                <StackPanel Margin="{StaticResource GapLeft12}">
                    <TextBlock Text="Light Space" Style="{StaticResource BodyStrong}"/>
                    <TextBlock Text="{Binding Devices.ConnectionText}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Devices.ProblemText}" Style="{StaticResource Warning}"/>
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Divider}"/>
            <Button Click="OnToggleLighting">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                        <Setter Property="Content" Value="Выключить всю подсветку"/>
                        <Setter Property="controls:Appearance.Icon" Value="&#xE7E8;"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.LightingEnabled}" Value="False">
                                <Setter Property="Content" Value="Включить подсветку"/>
                                <Setter Property="controls:Appearance.Icon" Value="&#xE706;"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Значок солнца у ползунка яркости, как в системном меню Windows -->
            <DockPanel Margin="{StaticResource PaddingMenuItem}">
                <TextBlock DockPanel.Dock="Left" Text="&#xE706;" Style="{StaticResource Icon}" VerticalAlignment="Bottom"
                           Margin="{StaticResource SliderIconMargin}"/>
                <controls:ValueSlider Label="Общая яркость" Unit="%" Minimum="0" Maximum="100" Step="1"
                                      Value="{Binding MasterBrightness}"/>
            </DockPanel>
            <Border Style="{StaticResource Divider}"
                    Visibility="{Binding HasProfiles, Converter={x:Static controls:BooleanToVisibilityConverter.Instance}}"/>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <!-- Профиль, который сейчас играет, отмечен галочкой; подсказка — что он включает на каждом устройстве -->
                    <DataTemplate DataType="vm:ProfileOption">
                        <Button Content="{Binding Name}" ToolTip="{Binding SummaryText}" Click="OnApplyProfile">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MenuButton}">
                                    <Setter Property="controls:Appearance.Icon" Value="&#xE790;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="controls:Appearance.Icon" Value="&#xE73E;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Divider}"/>
            <Button Style="{StaticResource MenuButton}" Content="Открыть Light Space" controls:Appearance.Icon="&#xE8A7;" Click="OnOpen"/>
            <Button Style="{StaticResource MenuButton}" Content="Выход" controls:Appearance.Icon="&#xE711;" Click="OnExit"/>
        </StackPanel>
    </Border>
</Window>
