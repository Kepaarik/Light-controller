<Application x:Class="LightSpace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Палитра стекла; тонировку, карточки, блик и слой содержимого GlassTheme перекрашивает по настройкам -->
                <ResourceDictionary Source="/LightSpace;component/Themes/Glass.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Themes/Tokens.xaml"/>

                <!-- Компоненты дизайн-системы -->
                <ResourceDictionary Source="/LightSpace;component/Styles/Text.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Styles/Inputs.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Styles/Selection.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Styles/Scroll.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Styles/Popups.xaml"/>
                <ResourceDictionary Source="/LightSpace;component/Styles/Scene.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
