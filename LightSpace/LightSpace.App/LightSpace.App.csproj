<Project Sdk="Microsoft.NET.Sdk">

  <!-- Окно, трей, страницы и компоненты дизайн-системы -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только для значка в трее (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LightSpace.App</RootNamespace>
    <AssemblyName>LightSpace</AssemblyName>
    <ApplicationIcon>Assets\LightSpace.ico</ApplicationIcon>
    <!-- Версия приложения: её показывают «Настройки», с ней сравнивается последний релиз на GitHub.
         Сборка релиза из тега задаёт её сама: -p:Version=1.2.3 -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Глобальные using WinForms конфликтуют с WPF (Application, Button, Color...) — типы WinForms берём только явно -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LightSpace.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightSpace.Core\LightSpace.Core.csproj" />
    <ProjectReference Include="..\LightSpace.Engine\LightSpace.Engine.csproj" />
  </ItemGroup>

</Project>
