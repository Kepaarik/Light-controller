<!-- Палитра «жидкого стекла» из LedHub: полупрозрачные слои поверх системного стекла окна (Acrylic или Mica).
     Тонировку окна, карточки, блик по краю и слой содержимого перекрашивает GlassTheme по настройкам стекла,
     поэтому они берутся только через DynamicResource -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Палитра: полупрозрачные слои поверх стекла окна -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0E0F16"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#1C1E2A"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#38000000"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#337C6CFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F5FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A5BA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A397FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#4D8B7CFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD99A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#6BB8FF"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B95F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A"/>
    <!-- Затемнение окна под модальной карточкой -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#990A0B10"/>
    <!-- Надписи на клавишах, закрашенных живыми цветами: зависят от яркости цвета клавиши -->
    <SolidColorBrush x:Key="KeyLabelOnBrightBrush" Color="#D9000000"/>
    <SolidColorBrush x:Key="KeyLabelOnDarkBrush" Color="#E6FFFFFF"/>

    <!-- «Жидкое стекло»: светлее сверху, с бликом по краю -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1CFFFFFF"/>
        <GradientStop Offset="1" Color="#0CFFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#40FFFFFF"/>
        <GradientStop Offset="0.45" Color="#10FFFFFF"/>
        <GradientStop Offset="1" Color="#22FFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7A6BFF"/>
        <GradientStop Offset="1" Color="#C35CFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#9184FF"/>
        <GradientStop Offset="1" Color="#D17BFF"/>
    </LinearGradientBrush>
    <!-- Слой с содержимым раздела, как в приложениях Windows 11 -->
    <SolidColorBrush x:Key="LayerBrush" Color="#0EFFFFFF"/>
    <!-- Тонировка стекла под всем окном; цвет и плотность задаются в настройках -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#600E0F16"/>

    <!-- Тени всплывающих карточек, ручек и модальных окон -->
    <DropShadowEffect x:Key="ShadowFlyout" po:Freeze="True" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowDialog" po:Freeze="True" BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.6" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowKnob" po:Freeze="True" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.45" Color="#000000"/>

</ResourceDictionary>
