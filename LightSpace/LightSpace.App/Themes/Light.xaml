<!-- Цвета, тени и обводки светлой темы. Ключи совпадают с Dark.xaml: при смене темы словарь подменяется целиком.
     Акцент свой, фиолетовый, от системного акцентного цвета не зависит -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Фон -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3"/>
    <!-- В светлой теме Acrylic не тонируется -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#00F3F3F3"/>
    <SolidColorBrush x:Key="LayerBrush" Color="#80FFFFFF"/>

    <!-- Поверхности -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="FlyoutBrush" Color="#F9F9F9"/>
    <!-- Стеклянная карточка: светлее сверху, с бликом по краю -->
    <LinearGradientBrush x:Key="CardBrush" po:Freeze="True" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#CCFFFFFF"/>
        <GradientStop Offset="1" Color="#99FFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdgeBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFFFFFF"/>
        <GradientStop Offset="0.45" Color="#14000000"/>
        <GradientStop Offset="1" Color="#1F000000"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBrush" Color="#4D000000"/>

    <!-- Элементы управления -->
    <SolidColorBrush x:Key="ControlBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="ControlStrongBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#29000000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFF"/>
    <!-- Слой состояния поверх заливки элемента: под курсором и при нажатии темнее.
         У акцентных и опасных кнопок под курсором слой светлее, чтобы был заметен на яркой заливке -->
    <SolidColorBrush x:Key="StateHoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="StatePressedBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="AccentStateHoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="AccentStatePressedBrush" Color="#26000000"/>

    <!-- Обводки -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextBrush" Color="#E4000000"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C000000"/>
    <!-- Надписи на клавишах, закрашенных живыми цветами: от темы не зависят, зависят от яркости цвета клавиши -->
    <SolidColorBrush x:Key="KeyLabelOnBrightBrush" Color="#D9000000"/>
    <SolidColorBrush x:Key="KeyLabelOnDarkBrush" Color="#E6FFFFFF"/>

    <!-- Акцент: фиолетовый, как в LedHub, но темнее, чтобы хватало контраста на светлом фоне -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6A5AE0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E66A5AE0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC6A5AE0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#336A5AE0"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4B3CC0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6A5AE0"/>
        <GradientStop Offset="1" Color="#A23FE0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7D6EEA"/>
        <GradientStop Offset="1" Color="#B05AEA"/>
    </LinearGradientBrush>

    <!-- Состояния -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#005FB7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#E6C42B1C"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#CCC42B1C"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="OnCloseHoverBrush" Color="#FFFFFF"/>

    <!-- Тени -->
    <DropShadowEffect x:Key="ShadowFlyout" po:Freeze="True" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowDialog" po:Freeze="True" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowKnob" po:Freeze="True" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25" Color="#000000"/>
    <!-- Мягкое свечение акцентом вокруг активных элементов -->
    <DropShadowEffect x:Key="ShadowAccentGlow" po:Freeze="True" BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#6A5AE0"/>

</ResourceDictionary>
