<!-- Цвета, тени и обводки тёмной темы. Ключи совпадают с Light.xaml: при смене темы словарь подменяется целиком.
     Акцент свой, фиолетовый, от системного акцентного цвета не зависит -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Фон: «жидкое стекло» как в LedHub. Тонировка лежит поверх Acrylic на всём окне: сверху слева светлее
         и с фиолетовым оттенком, к правому нижнему углу глубже; слой страниц — едва заметная светлая вуаль -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0E0F16"/>
    <LinearGradientBrush x:Key="BackdropTintBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#802A2748"/>
        <GradientStop Offset="1" Color="#991B1A31"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LayerBrush" Color="#0CFFFFFF"/>

    <!-- Поверхности: страница → карточка → всплывающая карточка, каждый уровень светлее предыдущего.
         Полупрозрачный белый ложится на стекло, а не закрывает его -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="FlyoutBrush" Color="#1C1E2A"/>
    <!-- Стеклянная карточка: светлее сверху, с бликом по краю -->
    <LinearGradientBrush x:Key="CardBrush" po:Freeze="True" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1CFFFFFF"/>
        <GradientStop Offset="1" Color="#0CFFFFFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdgeBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#40FFFFFF"/>
        <GradientStop Offset="0.45" Color="#10FFFFFF"/>
        <GradientStop Offset="1" Color="#22FFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBrush" Color="#A6050609"/>

    <!-- Элементы управления -->
    <SolidColorBrush x:Key="ControlBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="ControlStrongBrush" Color="#A0A5BA"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#80A0A5BA"/>
    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFF"/>
    <!-- Слой состояния поверх заливки элемента: под курсором светлее, при нажатии темнее.
         У акцентных и опасных кнопок слой сильнее, чтобы был заметен на яркой заливке -->
    <SolidColorBrush x:Key="StateHoverBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="StatePressedBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="AccentStateHoverBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="AccentStatePressedBrush" Color="#29000000"/>

    <!-- Обводки -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#80A0A5BA"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextBrush" Color="#F4F5FA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A5BA"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A7F94"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#4C5064"/>
    <!-- Надписи на клавишах, закрашенных живыми цветами: от темы не зависят, зависят от яркости цвета клавиши -->
    <SolidColorBrush x:Key="KeyLabelOnBrightBrush" Color="#D9000000"/>
    <SolidColorBrush x:Key="KeyLabelOnDarkBrush" Color="#E6FFFFFF"/>

    <!-- Акцент: фиолетовый, как в LedHub; у главных действий — градиент от фиолетового к пурпурному -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E68B7CFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC8B7CFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#338B7CFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#BDB4FF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7A6BFF"/>
        <GradientStop Offset="1" Color="#C35CFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#9184FF"/>
        <GradientStop Offset="1" Color="#D17BFF"/>
    </LinearGradientBrush>

    <!-- Состояния -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4FD18B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B95F"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#5AB8FF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#E6FF6B7A"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#CCFF6B7A"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#000000"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="OnCloseHoverBrush" Color="#FFFFFF"/>

    <!-- Тени -->
    <DropShadowEffect x:Key="ShadowFlyout" po:Freeze="True" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowDialog" po:Freeze="True" BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="0.65" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowKnob" po:Freeze="True" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.45" Color="#000000"/>
    <!-- Мягкое свечение акцентом вокруг активных элементов -->
    <DropShadowEffect x:Key="ShadowAccentGlow" po:Freeze="True" BlurRadius="16" ShadowDepth="0" Opacity="0.55" Color="#8B7CFF"/>

</ResourceDictionary>
