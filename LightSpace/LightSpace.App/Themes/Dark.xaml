<!-- Цвета, тени и обводки тёмной темы. Ключи совпадают с Light.xaml: при смене темы словарь подменяется целиком.
     Акцентные кисти здесь — запасные: при запуске их заменяет системный акцентный цвет -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- Фон -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020"/>
    <SolidColorBrush x:Key="LayerBrush" Color="#4C3A3A3A"/>

    <!-- Поверхности -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="FlyoutBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>

    <!-- Элементы управления -->
    <SolidColorBrush x:Key="ControlBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrongBrush" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="KnobBrush" Color="#FFFFFF"/>

    <!-- Обводки -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF"/>

    <!-- Текст -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF"/>

    <!-- Акцент (запасной) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E660CDFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#CC60CDFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3360CDFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#99EBFF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>

    <!-- Состояния -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#E6FF99A4"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#CCFF99A4"/>
    <SolidColorBrush x:Key="OnDangerBrush" Color="#000000"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="OnCloseHoverBrush" Color="#FFFFFF"/>

    <!-- Тени -->
    <DropShadowEffect x:Key="ShadowFlyout" po:Freeze="True" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowDialog" po:Freeze="True" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowKnob" po:Freeze="True" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4" Color="#000000"/>

</ResourceDictionary>
