<!-- Токены дизайн-системы: радиусы, отступы, шрифты, размеры, движение.
     Цвета и тени лежат в Glass.xaml и берутся только через DynamicResource -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Радиусы скругления -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <!-- Элемент внутри скруглённого контейнера с узким отступом, например вариант в сегментах или подсказка -->
    <CornerRadius x:Key="RadiusInner">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">18</CornerRadius>
    <CornerRadius x:Key="RadiusOverlay">18</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusTopLeftCard">12,0,0,0</CornerRadius>

    <!-- Отступы по сетке 4/8 px -->
    <Thickness x:Key="SpaceNone">0</Thickness>
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="GapRight4">0,0,4,0</Thickness>
    <Thickness x:Key="GapRight8">0,0,8,0</Thickness>
    <Thickness x:Key="GapRight12">0,0,12,0</Thickness>
    <Thickness x:Key="GapBottom4">0,0,0,4</Thickness>
    <Thickness x:Key="GapBottom8">0,0,0,8</Thickness>
    <Thickness x:Key="GapBottom16">0,0,0,16</Thickness>
    <Thickness x:Key="GapBottom24">0,0,0,24</Thickness>
    <Thickness x:Key="GapLeft8">8,0,0,0</Thickness>
    <Thickness x:Key="GapLeft12">12,0,0,0</Thickness>
    <Thickness x:Key="GapLeft24">24,0,0,0</Thickness>
    <Thickness x:Key="GapTop4">0,4,0,0</Thickness>
    <Thickness x:Key="GapTop8">0,8,0,0</Thickness>
    <Thickness x:Key="GapTop16">0,16,0,0</Thickness>
    <Thickness x:Key="GapTile">0,0,8,8</Thickness>
    <Thickness x:Key="PaddingControl">14,9</Thickness>
    <Thickness x:Key="PaddingCompact">8,6</Thickness>
    <Thickness x:Key="PaddingChip">10,5</Thickness>
    <Thickness x:Key="PaddingField">10,8</Thickness>
    <Thickness x:Key="PaddingCard">22</Thickness>
    <Thickness x:Key="PaddingOverlay">22</Thickness>
    <Thickness x:Key="PaddingFlyout">4</Thickness>
    <Thickness x:Key="PaddingListItem">10,9</Thickness>
    <Thickness x:Key="PaddingTile">6</Thickness>
    <Thickness x:Key="TileTitleMargin">4,8,4,2</Thickness>
    <Thickness x:Key="PaddingPage">32,28,32,24</Thickness>
    <Thickness x:Key="PaddingTooltip">8,4</Thickness>
    <Thickness x:Key="PaddingMenuItem">12,8</Thickness>
    <!-- Место вокруг всплывающей карточки, чтобы тень не обрезалась краем окна-попапа -->
    <Thickness x:Key="ShadowRoom">12</Thickness>
    <!-- Сдвиг выпадающей карточки на место для тени: карточка встаёт вровень с левым краем кнопки и чуть ниже неё,
         а пункт вложенного меню — вровень с пунктом, который его открыл -->
    <sys:Double x:Key="FlyoutOffsetX">-12</sys:Double>
    <sys:Double x:Key="FlyoutOffsetY">-8</sys:Double>
    <sys:Double x:Key="SubmenuOffsetY">-17</sys:Double>
    <Thickness x:Key="SectionLabelMargin">4,20,0,8</Thickness>
    <!-- Заголовок рамки группы на сцене: вровень с текстом карточек устройств внутри рамки -->
    <Thickness x:Key="GroupHeaderMargin">12,4,12,8</Thickness>

    <!-- Шрифты -->
    <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Размеры шрифта -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeIcon">16</sys:Double>
    <sys:Double x:Key="FontSizeIconSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeIconLarge">48</sys:Double>

    <!-- Размеры элементов -->
    <sys:Double x:Key="FieldHeight">40</sys:Double>
    <sys:Double x:Key="CaptionHeight">44</sys:Double>
    <GridLength x:Key="CaptionRowHeight">44</GridLength>
    <sys:Double x:Key="IconButtonSize">34</sys:Double>
    <sys:Double x:Key="ToggleWidth">40</sys:Double>
    <sys:Double x:Key="ToggleHeight">20</sys:Double>
    <Thickness x:Key="ToggleKnobMargin">4,0</Thickness>
    <sys:Double x:Key="SliderTrackHeight">6</sys:Double>
    <sys:Double x:Key="SliderThumbSize">18</sys:Double>
    <Thickness x:Key="PaddingSearch">32,6,12,6</Thickness>
    <Thickness x:Key="SearchIconMargin">10,0,0,0</Thickness>
    <sys:Double x:Key="SliderHeight">26</sys:Double>
    <sys:Double x:Key="ScrollBarSize">10</sys:Double>
    <sys:Double x:Key="TileWidth">132</sys:Double>
    <sys:Double x:Key="TilePreviewHeight">50</sys:Double>
    <sys:Double x:Key="FlyoutMinWidth">200</sys:Double>
    <sys:Double x:Key="PickerMinWidth">240</sys:Double>
    <sys:Double x:Key="PickerListMaxHeight">280</sys:Double>
    <!-- Поле для короткого числа, например угла поворота -->
    <sys:Double x:Key="NumberFieldWidth">104</sys:Double>
    <!-- Значок приложения в списке выбора и в списке сценариев -->
    <sys:Double x:Key="AppIconSize">24</sys:Double>
    <!-- Живое превью сценария в редакторе -->
    <sys:Double x:Key="ScenarioPreviewHeight">96</sys:Double>
    <sys:Double x:Key="DialogMaxWidth">440</sys:Double>
    <sys:Double x:Key="ContentMaxWidth">880</sys:Double>
    <sys:Double x:Key="ColorWheelSize">200</sys:Double>
    <sys:Double x:Key="SwatchSize">32</sys:Double>
    <!-- Образец цвета внутри кнопки выбора цвета -->
    <sys:Double x:Key="SwatchSmallSize">16</sys:Double>
    <!-- Панель эффекта справа на сцене: три плитки галереи в ряд -->
    <GridLength x:Key="ScenePanelWidth">500</GridLength>
    <sys:Double x:Key="EmptyStateMaxWidth">360</sys:Double>
    <!-- Колонка списка слева от панели выбранного элемента -->
    <GridLength x:Key="ListPaneWidth">300</GridLength>
    <!-- Раскладка клавиатуры: сторона стандартной клавиши и зазор между клавишами -->
    <sys:Double x:Key="KeyUnitSize">32</sys:Double>
    <sys:Double x:Key="KeyGap">4</sys:Double>
    <!-- Карта сцены: место над картой под подписи групп и устройств, высота холста слоёв в редакторе сценария -->
    <Thickness x:Key="SceneMapMargin">0,24,0,0</Thickness>
    <sys:Double x:Key="SceneEditorHeight">320</sys:Double>
    <!-- Ручка размера границ слоя: сторона и сдвиг, чтобы её середина стояла на углу границ -->
    <sys:Double x:Key="LayerHandleSize">12</sys:Double>
    <Thickness x:Key="LayerHandleMargin">0,0,-6,-6</Thickness>
    <!-- Пунктир границ слоя: длина штриха и промежутка в толщинах линии -->
    <DoubleCollection x:Key="DashPattern">4 3</DoubleCollection>

    <!-- Палитра обводок групп на сцене. Это не цвета темы, а цвета, которые выбирает пользователь и которые сохраняются
         в настройках, поэтому они одинаковы в обеих темах и подобраны так, чтобы читаться и на светлом, и на тёмном фоне -->
    <x:Array x:Key="GroupPalette" Type="{x:Type Color}">
        <Color>#0090FF</Color>
        <Color>#46A758</Color>
        <Color>#F76B15</Color>
        <Color>#8E4EC6</Color>
        <Color>#12A594</Color>
        <Color>#E5484D</Color>
        <Color>#FFC53D</Color>
        <Color>#D6409F</Color>
    </x:Array>

    <!-- Обводки -->
    <Thickness x:Key="StrokeThin">1</Thickness>
    <Thickness x:Key="StrokeThick">2</Thickness>
    <Thickness x:Key="StrokeBottom">0,0,0,1</Thickness>
    <Thickness x:Key="StrokeTopLeft">1,1,0,0</Thickness>
    <sys:Double x:Key="StrokeWidth">1</sys:Double>
    <sys:Double x:Key="StrokeWidthThick">2</sys:Double>

    <!-- Прозрачность выключенного элемента -->
    <sys:Double x:Key="OpacityDisabled">0.4</sys:Double>

    <!-- Движение: длительности и кривые -->
    <Duration x:Key="MotionNormal">0:0:0.167</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut"/>

</ResourceDictionary>
