<Window x:Class="LightSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
        xmlns:views="clr-namespace:LightSpace.App.Views"
        xmlns:controls="clr-namespace:LightSpace.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Light Space"
        Icon="Assets/LightSpace.ico"
        Width="1200" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontText}"
        FontSize="{StaticResource FontSizeBody}">

    <!-- Своя рамка: Mica тянется на всё окно, заголовок с вкладками и кнопками окна — свои -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource CaptionHeight}" GlassFrameThickness="-1" UseAeroCaptionButtons="False"
                      ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource CaptionRowHeight}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок: значок, название, вкладки; свободное место тянет окно; справа кнопки окна -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Space16}">
                <Image Source="Assets/LightSpace.ico" Width="{StaticResource FontSizeIcon}" Height="{StaticResource FontSizeIcon}"/>
                <TextBlock Text="Light Space" Style="{StaticResource Caption}" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" Margin="{StaticResource GapLeft12}"/>
            </StackPanel>

            <ListBox Grid.Column="1" Style="{StaticResource TitleTabs}" WindowChrome.IsHitTestVisibleInChrome="True"
                     ItemsSource="{Binding Pages}" DisplayMemberPath="Title"
                     SelectedValuePath="Page" SelectedValue="{Binding SelectedPage}"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Свернуть"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Развернуть"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <!-- Слой содержимого поверх Mica, как в приложениях Windows 11 -->
        <Border x:Name="PageHost" Grid.Row="1" Background="{DynamicResource LayerBrush}" CornerRadius="{StaticResource RadiusTopLeftCard}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="{StaticResource StrokeTopLeft}">
            <Grid x:Name="Pages">
                <views:ScenePage Visibility="{Binding SelectedPage, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Scene}"/>
                <views:ScenariosPage Visibility="{Binding SelectedPage, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Scenarios}"/>
                <views:DevicesPage Visibility="{Binding SelectedPage, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Devices}"/>
                <views:SettingsPage DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Settings}"/>
            </Grid>
        </Border>

        <!-- Модальные карточки поверх всего окна -->
        <controls:ModalHost x:Name="Modal" Grid.RowSpan="2"/>
    </Grid>
</Window>
