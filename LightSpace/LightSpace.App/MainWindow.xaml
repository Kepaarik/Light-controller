<Window x:Class="LightSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
        xmlns:views="clr-namespace:LightSpace.App.Views"
        xmlns:controls="clr-namespace:LightSpace.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Light Space"
        Icon="Assets/LightSpace.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontText}"
        FontSize="{StaticResource FontSizeBody}">

    <!-- Своя рамка: системное стекло (Acrylic или Mica) тянется на всё окно, кнопки свернуть/закрыть остаются системными -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource CaptionHeight}" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Тонировка лежит прямо на системном стекле: её цвет и плотность задаются в «Настройках» -->
    <Grid x:Name="Root" Background="{DynamicResource GlassTintBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource CaptionRowHeight}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок: значок и название; правый верхний угол свободен под системные кнопки -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="Assets/LightSpace.ico" Width="18" Height="18"/>
            <TextBlock Text="Light Space" FontSize="{StaticResource FontSizeCaption}" Margin="{StaticResource GapLeft12}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Левое меню разделов: кнопка сворачивает его до значков, в нешироком окне значки остаются всегда.
             Под разделами — найденные устройства, настройки — внизу меню -->
        <Border x:Name="Nav" Grid.Row="1" Width="232" Padding="10,8,10,12">
            <DockPanel>
                <Button DockPanel.Dock="Top" Style="{StaticResource IconButton}" controls:Appearance.Icon="&#xE700;"
                        ToolTip="Свернуть или развернуть меню" Command="{Binding ToggleMenuCommand}"
                        HorizontalAlignment="Left" Margin="5,0,0,8"/>
                <ListBox x:Name="NavList" DockPanel.Dock="Top" Style="{StaticResource NavList}"
                         ItemsSource="{Binding Pages}" SelectedValuePath="Page" SelectedValue="{Binding SelectedPage}"/>
                <ListBox x:Name="BottomNavList" DockPanel.Dock="Bottom" Style="{StaticResource NavList}"
                         ItemsSource="{Binding BottomPages}" SelectedValuePath="Page" SelectedValue="{Binding SelectedPage}"/>
                <!-- Устройств может быть много: они прокручиваются, а разделы и настройки остаются на месте.
                     Панель списка — обычная, а не виртуализирующая: внутри чужой прокрутки та может не показать ни одного пункта -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                    <ListBox x:Name="DeviceNavList" Style="{StaticResource NavList}"
                             ItemsSource="{Binding DeviceNav}" SelectedValuePath="Id" SelectedValue="{Binding SelectedDeviceId}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Слой содержимого поверх стекла: страницы. Скруглённая карточка с отступом справа и снизу — полоса заголовка
             с системными кнопками переходит в стеклянную рамку вокруг неё, а не обрывается прямой линией -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource LayerBrush}" CornerRadius="{StaticResource RadiusLayer}"
                Margin="{StaticResource LayerMargin}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource StrokeThin}">
            <Grid>
                <views:DevicePage DataContext="{Binding Scene}"
                                  Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Device}"/>
                <views:DevicesPage DataContext="{Binding Devices}"
                                   Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Devices}"/>
                <views:MonitorsPage DataContext="{Binding Monitors}"
                                    Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Monitors}"/>
                <views:SettingsPage DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Settings}"/>
            </Grid>
        </Border>

        <!-- Модальные карточки поверх окна под заголовком: системные кнопки окна остаются видны -->
        <controls:ModalHost x:Name="Modal" Grid.Row="1" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
