<Window x:Class="LightSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LightSpace.App.ViewModels"
        xmlns:views="clr-namespace:LightSpace.App.Views"
        xmlns:controls="clr-namespace:LightSpace.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Light Space"
        Icon="Assets/LightSpace.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource FontText}"
        FontSize="{StaticResource FontSizeBody}">

    <!-- Своя рамка: системное стекло (Acrylic или Mica) тянется на всё окно, кнопки свернуть/закрыть остаются системными -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource CaptionHeight}" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Тонировка лежит прямо на системном стекле: её цвет и плотность задаются в «Настройках» -->
    <Grid x:Name="Root" Background="{DynamicResource GlassTintBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource CaptionRowHeight}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок: значок и название; правый верхний угол свободен под системные кнопки -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="Assets/LightSpace.ico" Width="18" Height="18"/>
            <TextBlock Text="Light Space" FontSize="{StaticResource FontSizeCaption}" Margin="{StaticResource GapLeft12}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Левое меню разделов; в нешироком окне — только значки -->
        <Border x:Name="Nav" Grid.Row="1" Width="232" Padding="10,8,10,12">
            <ListBox x:Name="NavList" Style="{StaticResource NavList}"
                     ItemsSource="{Binding Pages}" SelectedValuePath="Page" SelectedValue="{Binding SelectedPage}"/>
        </Border>

        <!-- Слой содержимого поверх стекла: страницы -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource LayerBrush}" CornerRadius="{StaticResource RadiusTopLeftCard}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource StrokeTopLeft}">
            <Grid>
                <views:ScenePage Visibility="{Binding SelectedPage, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Scene}"/>
                <views:ScenariosPage Visibility="{Binding SelectedPage, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Scenarios}"/>
                <views:DevicesPage DataContext="{Binding Devices}"
                                   Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Devices}"/>
                <views:SettingsPage DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static controls:EqualsToVisibilityConverter.Instance}, ConverterParameter=Settings}"/>
            </Grid>
        </Border>

        <!-- Модальные карточки поверх окна под заголовком: системные кнопки окна остаются видны -->
        <controls:ModalHost x:Name="Modal" Grid.Row="1" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
