<Window x:Class="LedHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LedHub.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="LedHub — управление лентами"
        Width="1200" Height="740" MinWidth="980" MinHeight="600"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Найденные устройства -->
        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Устройства" Style="{StaticResource Header}"/>
                <Button DockPanel.Dock="Top" Content="Найти устройства" Command="{Binding ScanCommand}" Style="{StaticResource AccentButton}"/>
                <ProgressBar DockPanel.Dock="Top" Height="3" Margin="0,8,0,0" IsIndeterminate="True" BorderThickness="0"
                             Foreground="{StaticResource AccentBrush}" Background="Transparent"
                             Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Отметьте ленты галочками, чтобы создать из них группу или добавить в выбранную."/>

                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{Binding Protocol, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Address, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Warning}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Группы -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Группы" Style="{StaticResource Header}"/>
                <TextBlock DockPanel.Dock="Top" Text="Название новой группы" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                <TextBox DockPanel.Dock="Top" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                <Button DockPanel.Dock="Top" Content="Создать из отмеченных" Command="{Binding CreateGroupCommand}" Margin="0,8,0,0"/>

                <StackPanel DockPanel.Dock="Bottom">
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="Добавить отмеченные" Command="{Binding AddCheckedToGroupCommand}" Margin="0,0,4,0"/>
                        <Button Content="Удалить группу" Command="{Binding DeleteGroupCommand}" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <TextBlock Text="Состав группы" Style="{StaticResource SubHeader}"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedGroup.Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Content="✕" ToolTip="Убрать из группы" Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Name}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Text" Value="{Binding Name, StringFormat='{}{0} (не найдено)'}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Управление выбранной лентой или группой -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Управление" Style="{StaticResource Header}"/>
                    <TextBlock FontSize="16" TextTrimming="CharacterEllipsis"
                               Text="{Binding Target.Title, FallbackValue='Выберите устройство или группу'}"/>

                    <StackPanel IsEnabled="{Binding HasTarget}" Margin="0,12,0,0">
                        <UniformGrid Columns="2">
                            <Button Content="Включить" Command="{Binding TurnOnCommand}" Style="{StaticResource AccentButton}" Margin="0,0,4,0"/>
                            <Button Content="Выключить" Command="{Binding TurnOffCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <Border Height="64" CornerRadius="8" Margin="0,16,0,0" Background="{Binding PreviewHex}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                        <TextBlock Text="Цвет" Style="{StaticResource SubHeader}"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Красный" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Red}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Red}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Зелёный" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Green}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Green}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Синий" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Blue}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Blue}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Яркость" Style="{StaticResource SubHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Brightness}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat='{}{0} %'}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Быстрый выбор" Style="{StaticResource SubHeader}"/>
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Tuya требует локальный ключ устройства -->
                    <Border Visibility="{Binding IsTuyaSelected, Converter={StaticResource BoolToVisibility}}"
                            Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Настройки Tuya" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                                       Text="Tuya шифрует локальное управление ключом устройства (Local Key). Его можно получить через tinytuya wizard или на iot.tuya.com."/>
                            <TextBlock Text="Local Key" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TuyaLocalKey, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Набор DP: V2 — DP 20–24 (большинство лент), V1 — DP 1–5 (старые)" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding TuyaDpSchemes}" SelectedItem="{Binding TuyaDpScheme}"/>
                            <Button Content="Сохранить" Command="{Binding SaveTuyaSettingsCommand}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,12,2,0" Text="{Binding StatusText}" Style="{StaticResource Hint}"/>
    </Grid>
</Window>
