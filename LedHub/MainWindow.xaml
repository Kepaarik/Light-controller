<Window x:Class="LedHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LedHub.ViewModels"
        xmlns:views="clr-namespace:LedHub.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="LedHub"
        Icon="Assets/LedHub.ico"
        Width="1280" Height="820" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <!-- Своя рамка: системное стекло (Acrylic или Mica) тянется на всё окно, кнопки свернуть/закрыть остаются системными -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="6" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoHexCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок: значок и название; правый верхний угол свободен под системные кнопки -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="/Assets/LedHub.png" Width="18" Height="18"/>
            <TextBlock Text="LedHub" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Левое меню разделов; в нешироком окне — только значки -->
        <Border Grid.Row="1" Padding="10,8,10,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="232"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNavCompact}" Value="True">
                            <Setter Property="Width" Value="68"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource AccentButton}" ToolTip="Найти устройства">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14"/>
                            <TextBlock Text="Найти устройства" Margin="10,0,0,0"
                                       Visibility="{Binding IsNavCompact, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Margin="6,6,6,0"
                                 Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsDevicesPage}" ToolTip="Устройства">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="16" Width="20"/>
                            <TextBlock Text="Устройства" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsNavCompact, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsScenePage}" ToolTip="Сцена">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="16" Width="20"/>
                            <TextBlock Text="Сцена" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsNavCompact, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsMonitorsPage}" ToolTip="Подсветка мониторов">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="16" Width="20"/>
                            <TextBlock Text="Мониторы" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsNavCompact, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsSettingsPage}" ToolTip="Настройки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Width="20"/>
                            <TextBlock Text="Настройки" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsNavCompact, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Слой содержимого поверх стекла: страницы и строка статуса -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LayerBrush}" CornerRadius="12,0,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <views:DevicesPage Visibility="{Binding IsDevicesPage, Converter={StaticResource BoolToVisibility}}"/>
                <views:ScenePage Visibility="{Binding IsScenePage, Converter={StaticResource BoolToVisibility}}"/>
                <views:MonitorsPage Visibility="{Binding IsMonitorsPage, Converter={StaticResource BoolToVisibility}}"/>
                <views:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Строка статуса -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,8">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
