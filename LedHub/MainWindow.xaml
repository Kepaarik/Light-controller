<Window x:Class="LedHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LedHub.ViewModels"
        xmlns:controls="clr-namespace:LedHub.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="LedHub"
        Width="1240" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoHexCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Боковая панель: группы и найденные устройства -->
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,20">
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#7C6CFF"/>
                                <GradientStop Offset="1" Color="#FF6FB5"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LedHub" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Все ленты в одном месте" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource AccentButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Найти устройства"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Margin="6,6,6,0"
                                 Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="ГРУППЫ" Style="{StaticResource SectionLabel}"/>

                <Grid Grid.Row="3">
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" MaxHeight="210">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="&#xE902;" Style="{StaticResource Icon}" FontSize="15"
                                                       Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- Последний выставленный цвет группы -->
                                        <Ellipse Width="11" Height="11" Fill="{Binding ColorHex}" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PowerToggle}"
                                            Command="{Binding DataContext.TogglePowerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Групп пока нет — отметьте ленты и создайте группу ниже" Margin="4,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Tag="Название новой группы"/>
                    <Button Grid.Column="1" Command="{Binding CreateGroupCommand}" Margin="8,0,0,0" Padding="12,0"
                            ToolTip="Создать группу из отмеченных устройств">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14"/>
                    </Button>
                </Grid>

                <DockPanel Grid.Row="5">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Devices.Count}" Style="{StaticResource SectionLabel}" Margin="0,20,4,8"/>
                    <TextBlock Text="УСТРОЙСТВА" Style="{StaticResource SectionLabel}"/>
                </DockPanel>

                <Grid Grid.Row="6">
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip="Отметить для группы"/>
                                    <Grid Grid.Column="1" Margin="12,0,0,0">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource ControlBrush}">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- Последний выставленный цвет ленты -->
                                        <Ellipse Width="11" Height="11" Fill="{Binding ColorHex}" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Warning}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource PowerToggle}"
                                            Command="{Binding DataContext.TogglePowerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding DevicesPlaceholder}" Margin="4,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="7" Style="{StaticResource Hint}" Margin="4,12,0,0"
                           Text="Галочками отмечаются ленты для новой группы или для добавления в выбранную."/>
            </Grid>
        </Border>

        <!-- Пустое состояние, пока ничего не выбрано -->
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTarget}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource CardBrush}" HorizontalAlignment="Center">
                <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Выберите ленту или группу" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6"/>
            <TextBlock Text="Слева — найденные устройства и ваши группы" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Управление выбранной лентой или группой -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="32,28,32,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Target.Title}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Target.Subtitle}" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding TurnOnCommand}" Style="{StaticResource AccentButton}" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Включить"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding TurnOffCommand}" Style="{StaticResource GhostButton}" Padding="18,9" Margin="4,0,0,0">
                                <TextBlock Text="Выключить"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Разделы управления разнесены по вкладкам, чтобы не листать длинную страницу -->
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0,24,0,0">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Цвет"/>
                        </StackPanel>
                    </TabItem.Header>

                <Border Style="{StaticResource Card}" Padding="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:ColorWheel Width="290" Height="290" VerticalAlignment="Top"
                                             SelectedColor="{Binding SelectedColor}"/>

                        <StackPanel Grid.Column="1" Margin="36,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="56" Height="56" CornerRadius="16" Background="{Binding PreviewHex}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.7" Color="{Binding PreviewHex}"/>
                                    </Border.Effect>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Текущий цвет" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{Binding PreviewHex}" FontSize="20" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"/>
                                </StackPanel>
                            </StackPanel>

                            <DockPanel Margin="0,24,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                <TextBlock Text="Яркость" Style="{StaticResource Hint}"/>
                            </DockPanel>
                            <Slider Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="Transparent"
                                    Value="{Binding Brightness}">
                                <Slider.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#26272E"/>
                                        <GradientStop Offset="1" Color="{Binding PreviewHex}"/>
                                    </LinearGradientBrush>
                                </Slider.Background>
                            </Slider>

                            <ItemsControl ItemsSource="{Binding BrightnessPresets}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButton}" Content="{Binding}" ContentStringFormat="{}{0} %"
                                                Command="{Binding DataContext.SetBrightnessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Быстрый выбор" Style="{StaticResource Hint}" Margin="0,22,0,10"/>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding}"
                                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Точная настройка RGB" Style="{StaticResource Hint}" Margin="0,12,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="R" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Foreground="#FF5A64" Value="{Binding Red}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Red}" TextAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="G" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Foreground="#4CD98A" Value="{Binding Green}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" TextAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="B" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Foreground="#4C8DFF" Value="{Binding Blue}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Эффекты"/>
                        </StackPanel>
                    </TabItem.Header>
                <StackPanel>

                <!-- Эффекты рассчитывает приложение, поэтому они работают на любых лентах и синхронно в группе -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Command="{Binding StopEffectCommand}" Style="{StaticResource DangerButton}" Padding="12,7"
                                    Visibility="{Binding IsEffectRunning, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Остановить"/>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Эффекты" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock Text="{Binding EffectStatus}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Effects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource EffectTile}" Width="118"
                                            Command="{Binding DataContext.StartEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Height="48" CornerRadius="8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0" Color="{Binding PreviewFrom}"/>
                                                        <GradientStop Offset="1" Color="{Binding PreviewTo}"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" Margin="4,8,4,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,8,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding EffectSpeed, StringFormat='{}{0:0.0}×'}" FontWeight="SemiBold"/>
                            <TextBlock Text="Скорость" Style="{StaticResource Hint}"/>
                        </DockPanel>
                        <Slider Minimum="0.2" Maximum="3" Value="{Binding EffectSpeed}"/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Эффекты работают, пока приложение открыто. Цвет и яркость можно менять на ходу; на адресных лентах радуга бежит по светодиодам."/>
                    </StackPanel>
                </Border>

                <!-- Эффекты, зашитые в контроллер: идут плавно и работают даже при закрытом приложении -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding HasHardwareEffects, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Command="{Binding StartHardwareEffectCommand}" Style="{StaticResource AccentButton}"
                                    Padding="14,7" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Запустить"/>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Эффекты контроллера" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock Text="Встроены в саму ленту и продолжают работать, даже когда LedHub закрыт"
                                           Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <ListBox ItemsSource="{Binding HardwareEffects}" SelectedItem="{Binding SelectedHardwareEffect}" MaxHeight="260"
                                 DisplayMemberPath="Title"/>

                        <DockPanel Margin="0,12,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HardwareEffectSpeed, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                            <TextBlock Text="Скорость" Style="{StaticResource Hint}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding HardwareEffectSpeed}"/>
                    </StackPanel>
                </Border>

                <!-- Встроенный микрофон контроллера: лента сама реагирует на звук рядом с ней -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding HasMicrophone, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding EnableMicrophoneCommand}" Style="{StaticResource AccentButton}" Padding="14,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Включить"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DisableMicrophoneCommand}" Style="{StaticResource GhostButton}" Padding="14,7" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xF781;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Выключить"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Микрофон контроллера" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock Text="Лента сама зажигает светодиоды в такт звуку рядом с ней — голосу, музыке"
                                           Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Музыкальный режим" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding MicrophoneModes}" SelectedItem="{Binding SelectedMicrophoneMode}" DisplayMemberPath="Title">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <DockPanel Margin="0,12,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MicrophoneSensitivity, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                            <TextBlock Text="Чувствительность" Style="{StaticResource Hint}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MicrophoneSensitivity}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
                </TabItem>

                <TabItem Visibility="{Binding IsAddressableSelected, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Светодиоды"/>
                        </StackPanel>
                    </TabItem.Header>

                <!-- Цвет каждого светодиода — только для адресных лент -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Залить всю ленту" Command="{Binding FillLedsCommand}" Padding="12,7"/>
                                <Button Content="Погасить все" Command="{Binding ClearLedsCommand}" Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Светодиоды" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock Text="Нажмите или проведите мышью по светодиодам, чтобы закрасить их текущим цветом"
                                           Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кисть: на этой вкладке круг выбирает цвет для закрашивания, а не заливает ленту -->
                            <StackPanel Margin="0,0,28,0">
                                <controls:ColorWheel Width="190" Height="190" SelectedColor="{Binding SelectedColor}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding PreviewHex}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PreviewHex}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding LedCells}" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,5,5" Cursor="Hand"
                                                Background="{Binding Hex}" ToolTip="{Binding Title}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                MouseLeftButtonDown="LedCell_MouseLeftButtonDown" MouseEnter="LedCell_MouseEnter"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
                </TabItem>

                <TabItem Visibility="{Binding SupportsHexLayout, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Форма"/>
                        </StackPanel>
                    </TabItem.Header>

                <!-- Редактор формы из шестигранников: раскладка как на стене и рисование по 7 светодиодам каждого -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Режим" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="HexMode" IsChecked="{Binding IsShapeMode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Форма"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="HexMode" IsChecked="{Binding IsPaintLedMode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Светодиод"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentRadio}" GroupName="HexMode" IsChecked="{Binding IsPaintHexMode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE771;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                    <TextBlock Text="Шестигранник целиком"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="Цвет кисти" Style="{StaticResource Hint}" Margin="0,14,0,8"/>
                            <controls:ColorWheel Width="170" Height="170" HorizontalAlignment="Left" SelectedColor="{Binding SelectedColor}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Width="18" Height="18" CornerRadius="9" Background="{Binding PreviewHex}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding PreviewHex}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Content="Залить всё цветом кисти" Command="{Binding FillHexLayoutCommand}" Margin="0,16,0,0"/>
                            <Button Content="Очистить форму" Command="{Binding ClearHexLayoutCommand}" Style="{StaticResource DangerButton}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding UndoHexCommand}" Style="{StaticResource GhostButton}"
                                        ToolTip="Отменить последнюю правку (Ctrl+Z)" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Отменить"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{Binding HexSummary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding HexModeHint}" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource WindowBrush}" CornerRadius="10" Height="460">
                                <controls:HexCanvas Layout="{Binding HexLayout}" Mode="{Binding HexEditMode}" Version="{Binding HexLayoutVersion}"
                                                    BrushColor="{Binding SelectedColor}" ChangedCommand="{Binding HexLayoutChangedCommand}"
                                                    EditStartingCommand="{Binding HexEditStartingCommand}"/>
                            </Border>
                            <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                <DockPanel>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarningBrush}"
                                               VerticalAlignment="Top" Margin="0,1,10,0"/>
                                    <TextBlock Text="{Binding HexSendHint}" Style="{StaticResource Hint}"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </TabItem.Header>
                <StackPanel>

                <!-- Своё название ленты или группы -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Название" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="Удобное имя вместо заводского, например «Шестигранники над столом». Пустое поле вернёт заводское имя ленты."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Tag="Название"/>
                            <Button Grid.Column="1" Content="Сохранить" Command="{Binding RenameCommand}"
                                    Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Состав выбранной группы -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding IsGroupSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding AddCheckedToGroupCommand}" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Добавить отмеченные"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteGroupCommand}" Style="{StaticResource DangerButton}" Padding="12,7" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Удалить группу"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Состав группы" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding SelectedGroup.Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ControlBrush}" CornerRadius="8" Padding="12,4,4,4" Margin="0,4,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Убрать из группы"
                                                    Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                                            </Button>
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#4CD98A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="MemberName" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource MutedBrush}"/>
                                            <Setter TargetName="MemberName" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter TargetName="MemberName" Property="Text" Value="{Binding Name, StringFormat='{}{0} — не найдено'}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Tuya требует локальный ключ устройства -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding IsTuyaSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Настройки Tuya" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="Tuya шифрует локальное управление ключом устройства (Local Key). Его можно получить через tinytuya wizard или на iot.tuya.com."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TuyaLocalKey, UpdateSourceTrigger=PropertyChanged}" Tag="Local Key (16 символов)"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding TuyaDpSchemes}" SelectedItem="{Binding TuyaDpScheme}"/>
                            <Button Grid.Column="2" Content="Сохранить" Command="{Binding SaveTuyaSettingsCommand}"
                                    Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Набор DP: V2 — DP 20–24 (большинство лент), V1 — DP 1–5 (старые контроллеры)"
                                   Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                </StackPanel>
                </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Строка статуса -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,10">
            <DockPanel>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
