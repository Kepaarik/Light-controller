<UserControl x:Class="LedHub.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LedHub.ViewModels"
             xmlns:views="clr-namespace:LedHub.Views"
             xmlns:controls="clr-namespace:LedHub.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список: группы, устройства и пресеты. На узком окне занимает всю ширину, пока ничего не выбрано -->
        <Border Visibility="{Binding ShowDeviceList, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="340"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="18,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="4,0,0,4">
                    <Button DockPanel.Dock="Right" Command="{Binding ScanCommand}" Style="{StaticResource GhostButton}" ToolTip="Найти устройства заново">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14"/>
                    </Button>
                    <TextBlock Text="Устройства" Style="{StaticResource PageTitle}" FontSize="24"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="ГРУППЫ" Style="{StaticResource SectionLabel}" Margin="4,14,0,8"/>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="&#xE902;" Style="{StaticResource Icon}" FontSize="15"
                                                       Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- Последний выставленный цвет группы -->
                                        <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PowerToggle}"
                                            Command="{Binding DataContext.TogglePowerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Групп пока нет — отметьте ленты и создайте группу ниже" Margin="4,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Tag="Название новой группы"/>
                    <Button Grid.Column="1" Command="{Binding CreateGroupCommand}" Margin="8,0,0,0" Padding="12,0"
                            ToolTip="Создать группу из отмеченных устройств">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14"/>
                    </Button>
                </Grid>

                <DockPanel Grid.Row="4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Devices.Count}" Style="{StaticResource SectionLabel}" Margin="0,20,4,8"/>
                    <TextBlock Text="ЛЕНТЫ И ПАНЕЛИ" Style="{StaticResource SectionLabel}"/>
                </DockPanel>

                <Grid Grid.Row="5">
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip="Отметить для группы"/>
                                    <Grid Grid.Column="1" Margin="12,0,0,0">
                                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource ControlBrush}">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- Последний выставленный цвет ленты -->
                                        <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" Stroke="{StaticResource SidebarBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Warning}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource PowerToggle}"
                                            Command="{Binding DataContext.TogglePowerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding DevicesPlaceholder}" Margin="4,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="6" Text="ПРЕСЕТЫ" Style="{StaticResource SectionLabel}"/>

                <!-- Пресеты: сохранённое состояние всех лент, включается одним кликом -->
                <StackPanel Grid.Row="7">
                    <ItemsControl ItemsSource="{Binding Scenes}" MaxHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource ControlBrush}" CornerRadius="10" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource TextBrush}" Padding="10,6"
                                                ToolTip="Включить пресет"
                                                Command="{Binding DataContext.ApplySceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,6,0"
                                                           Foreground="{StaticResource AccentHoverBrush}"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="6,6" ToolTip="Удалить пресет"
                                                Command="{Binding DataContext.DeleteSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="9"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}" Tag="Сохранить как пресет…"/>
                        <Button Grid.Column="1" Command="{Binding SaveSceneCommand}" Margin="8,0,0,0" Padding="12,0"
                                ToolTip="Запомнить цвет, яркость и включение всех лент">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="8" Style="{StaticResource Hint}" Margin="4,12,0,0"
                           Text="Галочками отмечаются ленты для новой группы или для добавления в выбранную."/>
            </Grid>
        </Border>

        <!-- Управление выбранной лентой или группой -->
        <Grid Grid.Column="1" Visibility="{Binding ShowDeviceDetail, Converter={StaticResource BoolToVisibility}}">

            <!-- Пустое состояние, пока ничего не выбрано -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibility}}">
                <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="38" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Выберите ленту или группу" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,6"/>
                <TextBlock Text="Слева — найденные устройства и ваши группы" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="32,24,32,24">

                    <Button Command="{Binding BackToListCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,0,0,8"
                            Visibility="{Binding IsNarrow, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Все устройства"/>
                        </StackPanel>
                    </Button>

                    <controls:ResponsivePanel BreakWidth="640" Spacing="14">
                        <StackPanel controls:ResponsivePanel.Fill="True" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Target.Title}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding Target.Subtitle}" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding HasSleepTimer, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SleepTimerText}" Foreground="{StaticResource AccentHoverBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding TurnOnCommand}" Style="{StaticResource AccentButton}" Padding="18,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Включить"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding TurnOffCommand}" Style="{StaticResource GhostButton}" Padding="18,9" Margin="4,0,0,0">
                                    <TextBlock Text="Выключить"/>
                                </Button>

                                <!-- Таймер сна: меню с вариантами выпадает под кнопкой -->
                                <ToggleButton x:Name="SleepTimerButton" IsChecked="{Binding IsSleepTimerMenuOpen}" Margin="4,0,0,0"
                                              Cursor="Hand" ToolTip="Выключить по таймеру" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Root" CornerRadius="10" Padding="12,9" Background="Transparent">
                                                <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource ControlBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsSleepTimerMenuOpen}" PlacementTarget="{Binding ElementName=SleepTimerButton}"
                                       Placement="Bottom" HorizontalOffset="-150" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource PopupBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="14" Width="200">
                                        <StackPanel>
                                            <TextBlock Text="Выключить через" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding SleepTimerOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}" ContentStringFormat="{}{0} мин" Margin="0,0,6,6"
                                                                Command="{Binding DataContext.StartSleepTimerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Отменить таймер" Command="{Binding CancelSleepTimerCommand}" Style="{StaticResource GhostButton}"
                                                    Margin="0,2,6,0" Visibility="{Binding HasSleepTimer, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                    </controls:ResponsivePanel>

                    <!-- Разделы управления разнесены по вкладкам, чтобы не листать длинную страницу -->
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0,24,0,0">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Цвет"/>
                            </StackPanel>
                        </TabItem.Header>

                    <Border Style="{StaticResource Card}" Padding="28">
                        <controls:ResponsivePanel BreakWidth="620" Spacing="36">

                            <controls:ColorWheel Width="280" Height="280" VerticalAlignment="Top" HorizontalAlignment="Center"
                                                 SelectedColor="{Binding SelectedColor}"/>

                            <StackPanel controls:ResponsivePanel.Fill="True">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="56" Height="56" CornerRadius="16" Background="{Binding PreviewHex}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.7" Color="{Binding PreviewHex}"/>
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Текущий цвет" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding PreviewHex}" FontSize="20" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"/>
                                    </StackPanel>
                                </StackPanel>

                                <DockPanel Margin="0,24,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Яркость" Style="{StaticResource Hint}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Foreground="Transparent"
                                        Value="{Binding Brightness}">
                                    <Slider.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#26272E"/>
                                            <GradientStop Offset="1" Color="{Binding PreviewHex}"/>
                                        </LinearGradientBrush>
                                    </Slider.Background>
                                </Slider>

                                <ItemsControl ItemsSource="{Binding BrightnessPresets}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChipButton}" Content="{Binding}" ContentStringFormat="{}{0} %" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.SetBrightnessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Быстрый выбор" Style="{StaticResource Hint}" Margin="0,16,0,10"/>
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding}" ToolTip="{Binding}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding HasRecentColors, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Недавние" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                                    <ItemsControl ItemsSource="{Binding RecentColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SwatchButton}" Width="26" Height="26" Background="{Binding}" ToolTip="{Binding}"
                                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="Точная настройка RGB" Style="{StaticResource Hint}" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="R" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Foreground="#FF5A64" Value="{Binding Red}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Red}" TextAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Text="G" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Foreground="#4CD98A" Value="{Binding Green}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" TextAlignment="Right" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Text="B" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Foreground="#4C8DFF" Value="{Binding Blue}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </controls:ResponsivePanel>
                    </Border>

                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Эффекты"/>
                            </StackPanel>
                        </TabItem.Header>
                    <StackPanel>

                    <!-- Эффекты рассчитывает приложение, поэтому они работают на любых лентах и синхронно в группе -->
                    <views:EffectPanel DataContext="{Binding EffectPicker}"/>

                    <TextBlock Style="{StaticResource Hint}" Margin="4,6,0,0"
                               Text="Эффекты работают, пока приложение открыто; на адресных лентах узор бежит по светодиодам. Яркость — на вкладке «Цвет». Чтобы эффект прошёл через все ленты по их местам на стене, запустите его в разделе «Сцена»."/>

                    <!-- Эффекты, зашитые в контроллер: идут плавно и работают даже при закрытом приложении -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding HasHardwareEffects, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Command="{Binding StartHardwareEffectCommand}" Style="{StaticResource AccentButton}"
                                        Padding="14,7" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Запустить"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Эффекты контроллера" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="Встроены в саму ленту и продолжают работать, даже когда LedHub закрыт"
                                               Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <ListBox ItemsSource="{Binding HardwareEffects}" SelectedItem="{Binding SelectedHardwareEffect}" MaxHeight="260"
                                     DisplayMemberPath="Title"/>

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HardwareEffectSpeed, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                <TextBlock Text="Скорость" Style="{StaticResource Hint}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding HardwareEffectSpeed}"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Музыка"/>
                            </StackPanel>
                        </TabItem.Header>
                    <StackPanel>

                    <!-- Музыка с компьютера: ленты реагируют на звук, который играет в колонках или наушниках -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Command="{Binding StopEffectCommand}" Style="{StaticResource DangerButton}" Padding="12,7"
                                        Visibility="{Binding IsEffectRunning, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Остановить"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Музыка с компьютера" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="{Binding EffectStatus}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding MusicModes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EffectTile}" Width="210" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.StartMusicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="0,8,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MusicGain, StringFormat='{}{0:0.0}×'}" FontWeight="SemiBold"/>
                                <TextBlock Text="Чувствительность" Style="{StaticResource Hint}"/>
                            </DockPanel>
                            <Slider Minimum="0.5" Maximum="3" Value="{Binding MusicGain}"/>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Звук берётся с устройства вывода по умолчанию — микрофон не нужен. Громкость подстраивается сама; цвет кисти для «Пульса» и яркость меняются на вкладке «Цвет» прямо во время музыки. Больше музыкальных эффектов — на вкладке «Эффекты» и в разделе «Сцена»."/>
                        </StackPanel>
                    </Border>

                    <!-- Встроенный микрофон контроллера: лента сама реагирует на звук рядом с ней -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding HasMicrophone, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding EnableMicrophoneCommand}" Style="{StaticResource AccentButton}" Padding="14,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Включить"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DisableMicrophoneCommand}" Style="{StaticResource GhostButton}" Padding="14,7" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF781;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Выключить"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Микрофон контроллера" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="Лента сама зажигает светодиоды в такт звуку рядом с ней — голосу, музыке"
                                               Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Музыкальный режим" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding MicrophoneModes}" SelectedItem="{Binding SelectedMicrophoneMode}" DisplayMemberPath="Title">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <DockPanel Margin="0,12,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MicrophoneSensitivity, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                <TextBlock Text="Чувствительность" Style="{StaticResource Hint}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MicrophoneSensitivity}"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </TabItem>

                    <TabItem Visibility="{Binding IsAddressableSelected, Converter={StaticResource BoolToVisibility}}">
                        <TabItem.Header>
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsKeyboardSelected, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xE80A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Светодиоды"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsKeyboardSelected, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Клавиатура"/>
                                </StackPanel>
                            </Grid>
                        </TabItem.Header>
                    <Grid>

                    <!-- Цвет каждого светодиода — только для адресных лент -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsKeyboardSelected, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <controls:ResponsivePanel BreakWidth="620" Spacing="12" Margin="0,0,0,14">
                                <StackPanel controls:ResponsivePanel.Fill="True">
                                    <TextBlock Text="Светодиоды" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="Нажмите или проведите мышью по светодиодам, чтобы закрасить их текущим цветом"
                                               Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Залить всю ленту" Command="{Binding FillLedsCommand}" Padding="12,7"/>
                                    <Button Content="Погасить все" Command="{Binding ClearLedsCommand}" Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0"/>
                                </StackPanel>
                            </controls:ResponsivePanel>

                            <controls:ResponsivePanel BreakWidth="560" Spacing="28">

                                <!-- Кисть: на этой вкладке круг выбирает цвет для закрашивания, а не заливает ленту -->
                                <StackPanel HorizontalAlignment="Left">
                                    <controls:ColorWheel Width="190" Height="190" SelectedColor="{Binding SelectedColor}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding PreviewHex}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding PreviewHex}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl controls:ResponsivePanel.Fill="True" ItemsSource="{Binding LedCells}" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,5,5" Cursor="Hand"
                                                    Background="{Binding Hex}" ToolTip="{Binding Title}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    MouseLeftButtonDown="LedCell_MouseLeftButtonDown" MouseEnter="LedCell_MouseEnter"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:ResponsivePanel>
                        </StackPanel>
                    </Border>

                    <!-- Клавиатура: клавиши на её раскладке во всю ширину и эффекты её прошивки -->
                    <StackPanel Visibility="{Binding IsKeyboardSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <controls:ResponsivePanel BreakWidth="620" Spacing="12" Margin="0,0,0,14">
                                    <StackPanel controls:ResponsivePanel.Fill="True">
                                        <TextBlock Text="Клавиши" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock Text="Нажмите или проведите мышью по клавишам, чтобы закрасить их текущим цветом"
                                                   Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Залить всю клавиатуру" Command="{Binding FillLedsCommand}" Padding="12,7"/>
                                        <Button Content="Погасить все" Command="{Binding ClearLedsCommand}" Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0"/>
                                        <Button Command="{Binding ToggleDeviceListCommand}" Style="{StaticResource GhostButton}" Padding="12,7" Margin="6,0,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsDeviceListCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock Text="&#xE740;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock Text="На всю ширину"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsDeviceListCollapsed, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="&#xE73F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Показать список"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </controls:ResponsivePanel>

                                <!-- Кисть: на этой вкладке круг выбирает цвет для закрашивания, а не заливает клавиатуру -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <controls:ColorWheel Width="150" Height="150" SelectedColor="{Binding SelectedColor}"/>
                                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding PreviewHex}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding PreviewHex}" FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Клавиатура растягивается на всю ширину карточки -->
                                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch">
                                    <ItemsControl ItemsSource="{Binding KeyCells}" Width="{Binding KeyboardWidth}" Height="{Binding KeyboardHeight}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="{Binding Height}" Padding="2" Background="Transparent" Cursor="Hand"
                                                        ToolTip="{Binding Cell.Title}"
                                                        MouseLeftButtonDown="LedCell_MouseLeftButtonDown" MouseEnter="LedCell_MouseEnter">
                                                    <Border CornerRadius="6" Background="{Binding Cell.Hex}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <!-- Эффекты, зашитые в прошивку клавиатуры: идут плавно, без мерцания, и работают даже при закрытом приложении -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                                Visibility="{Binding HasKeyboardEffects, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Command="{Binding StartKeyboardEffectCommand}" Style="{StaticResource AccentButton}"
                                            Padding="14,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Запустить"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Эффекты клавиатуры" Style="{StaticResource CardTitle}" Margin="0"/>
                                        <TextBlock Text="Встроены в саму клавиатуру: идут плавно и продолжают работать, даже когда LedHub закрыт"
                                                   Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <ListBox ItemsSource="{Binding KeyboardEffects}" SelectedItem="{Binding SelectedKeyboardEffect}" DisplayMemberPath="Title">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <CheckBox Content="Все цвета (радуга)" IsChecked="{Binding IsKeyboardEffectMulticolor}" Margin="0,12,0,0"/>
                                <TextBlock Text="Без галочки эффект идёт цветом, выбранным на круге выше"
                                           Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                                <DockPanel Margin="0,12,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding KeyboardEffectBrightness, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Яркость" Style="{StaticResource Hint}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding KeyboardEffectBrightness}"/>

                                <DockPanel Margin="0,12,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding KeyboardEffectSpeed, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Скорость" Style="{StaticResource Hint}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding KeyboardEffectSpeed}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    </Grid>
                    </TabItem>

                    <TabItem Visibility="{Binding SupportsHexLayout, Converter={StaticResource BoolToVisibility}}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Форма"/>
                            </StackPanel>
                        </TabItem.Header>

                    <!-- Редактор формы из шестигранников: раскладка как на стене и рисование по 7 светодиодам каждого -->
                    <Border Style="{StaticResource Card}">
                        <controls:ResponsivePanel BreakWidth="680" Spacing="24">

                            <StackPanel Width="210" HorizontalAlignment="Left">
                                <TextBlock Text="Режим" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="HexMode" IsChecked="{Binding IsShapeMode}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                        <TextBlock Text="Форма"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="HexMode" IsChecked="{Binding IsPaintLedMode}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                        <TextBlock Text="Светодиод"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="HexMode" IsChecked="{Binding IsPaintHexMode}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE771;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                        <TextBlock Text="Шестигранник целиком"/>
                                    </StackPanel>
                                </RadioButton>

                                <TextBlock Text="Цвет кисти" Style="{StaticResource Hint}" Margin="0,14,0,8"/>
                                <controls:ColorWheel Width="170" Height="170" HorizontalAlignment="Left" SelectedColor="{Binding SelectedColor}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding PreviewHex}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PreviewHex}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="Залить всё цветом кисти" Command="{Binding FillHexLayoutCommand}" Margin="0,16,0,0"/>
                                <Button Content="Очистить форму" Command="{Binding ClearHexLayoutCommand}" Style="{StaticResource DangerButton}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel controls:ResponsivePanel.Fill="True">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding UndoHexCommand}" Style="{StaticResource GhostButton}"
                                            ToolTip="Отменить последнюю правку (Ctrl+Z)" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Отменить"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding HexSummary}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding HexModeHint}" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Background="{StaticResource InsetBrush}" CornerRadius="12" Height="460">
                                    <controls:HexCanvas Layout="{Binding HexLayout}" Mode="{Binding HexEditMode}" Version="{Binding HexLayoutVersion}"
                                                        BrushColor="{Binding SelectedColor}" ChangedCommand="{Binding HexLayoutChangedCommand}"
                                                        EditStartingCommand="{Binding HexEditStartingCommand}"/>
                                </Border>
                                <Border Background="{StaticResource ControlBrush}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarningBrush}"
                                                   VerticalAlignment="Top" Margin="0,1,10,0"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Рисунок сразу отправляется на ленту: светодиоды идут по порядку номеров шестигранников, внутри — центр и затем по часовой стрелке от верхнего. На сцене панель повторит эту форму."/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </controls:ResponsivePanel>
                    </Border>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Настройки"/>
                            </StackPanel>
                        </TabItem.Header>
                    <StackPanel>

                    <!-- Своё название ленты или группы -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Название" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                       Text="Удобное имя вместо заводского, например «Шестигранники над столом». Пустое поле вернёт заводское имя ленты."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Tag="Название"/>
                                <Button Grid.Column="1" Content="Сохранить" Command="{Binding RenameCommand}"
                                        Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Состав выбранной группы -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding IsGroupSelected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <controls:ResponsivePanel BreakWidth="560" Spacing="10" Margin="0,0,0,8">
                                <TextBlock Text="Состав группы" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"
                                           controls:ResponsivePanel.Fill="True"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AddCheckedToGroupCommand}" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Добавить отмеченные"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteGroupCommand}" Style="{StaticResource DangerButton}" Padding="12,7" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Удалить группу"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:ResponsivePanel>

                            <ItemsControl ItemsSource="{Binding SelectedGroup.Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ControlBrush}" CornerRadius="10" Padding="12,4,4,4" Margin="0,4,0,0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Убрать из группы"
                                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11"/>
                                                </Button>
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#4CD98A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="MemberName" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource MutedBrush}"/>
                                                <Setter TargetName="MemberName" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Setter TargetName="MemberName" Property="Text" Value="{Binding Name, StringFormat='{}{0} — не найдено'}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Tuya требует локальный ключ устройства -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding IsTuyaSelected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Настройки Tuya" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                       Text="Tuya шифрует локальное управление ключом устройства (Local Key). Его можно получить через tinytuya wizard или на iot.tuya.com."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TuyaLocalKey, UpdateSourceTrigger=PropertyChanged}" Tag="Local Key (16 символов)"/>
                                <ComboBox Grid.Column="1" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding TuyaDpSchemes}" SelectedItem="{Binding TuyaDpScheme}"/>
                                <Button Grid.Column="2" Content="Сохранить" Command="{Binding SaveTuyaSettingsCommand}"
                                        Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Набор DP: V2 — DP 20–24 (большинство лент), V1 — DP 1–5 (старые контроллеры)"
                                       Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
