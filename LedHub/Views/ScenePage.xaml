<UserControl x:Class="LedHub.Views.ScenePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LedHub.ViewModels"
             xmlns:views="clr-namespace:LedHub.Views"
             xmlns:controls="clr-namespace:LedHub.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" DataContext="{Binding Scene}">

            <controls:ResponsivePanel BreakWidth="680" Spacing="16">
                <StackPanel controls:ResponsivePanel.Fill="True" VerticalAlignment="Center">
                    <TextBlock Text="Сцена" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AutoLayoutCommand}" Style="{StaticResource GhostButton}" Foreground="{StaticResource TextBrush}"
                            Padding="14,9" Margin="0,0,6,0"
                            ToolTip="Поставить на сцену всё найденное и расставить: мониторы в ряд, клавиатуры под основным монитором, ленты и панели по бокам">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A1;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Расставить автоматически"/>
                        </StackPanel>
                    </Button>

                    <!-- Предпросмотр: выбранный эффект играет только на схеме, ленты не трогаются -->
                    <Button Command="{Binding TogglePreviewCommand}" Padding="16,9"
                            ToolTip="Показать выбранный эффект только на схеме, не трогая ленты">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Предпросмотр"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Effects.StopCommand}" Style="{StaticResource DangerButton}" Padding="16,9" Margin="6,0,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Остановить"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:ResponsivePanel>

            <controls:ResponsivePanel BreakWidth="900" Spacing="16" Margin="0,24,0,0">

                <!-- Схема: расстановка на стене, вид спереди -->
                <Border Style="{StaticResource Panel}" controls:ResponsivePanel.Fill="True" Padding="14">
                    <StackPanel>
                        <Border Background="{StaticResource InsetBrush}" CornerRadius="14" Height="440">
                            <Grid>
                                <controls:SceneCanvas Scene="{Binding}" Version="{Binding Version}"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Сцена пока пустая" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="Добавьте мониторы и устройства справа" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="6,10,6,2"
                                   Text="Перетаскивайте элементы мышью, колесо поворачивает выбранный (с Shift — точнее), за белые точки на концах ленты можно потянуть. Alt — без привязки к сетке, стрелки — сдвиг, Delete — убрать со сцены. Ленты подсветки мониторов стоят вместе со своим монитором."/>
                    </StackPanel>
                </Border>

                <StackPanel Width="300" HorizontalAlignment="Left">

                    <!-- Выбранный элемент -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="Выберите элемент на схеме, чтобы настроить его размер и поворот."
                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <StackPanel DataContext="{Binding SelectedItem}"
                                        Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Как устройство показывает эффект сцены: вместе со всеми, само по себе или никак -->
                                <StackPanel Visibility="{Binding ShowsProjection, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                                    <TextBlock Text="Эффект сцены" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Style="{StaticResource SegmentRadio}" Margin="0,0,3,0" IsChecked="{Binding IsTogether}">
                                            <TextBlock Text="В связке" HorizontalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadio}" Margin="3,0,3,0" IsChecked="{Binding IsSeparate}">
                                            <TextBlock Text="Отдельно" HorizontalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SegmentRadio}" Margin="3,0,0,0" IsChecked="{Binding IsExcluded}">
                                            <TextBlock Text="Не играет" HorizontalAlignment="Center"/>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding ProjectionHint}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,16,0,4" Visibility="{Binding ShowsKindChoice, Converter={StaticResource BoolToVisibility}}">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Margin="0,0,4,0" IsChecked="{Binding IsLineKind}">
                                        <TextBlock Text="Лента"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegmentRadio}" Margin="4,0,0,0" IsChecked="{Binding IsPanelKind}">
                                        <TextBlock Text="Шестигранники"/>
                                    </RadioButton>
                                </UniformGrid>

                                <StackPanel Visibility="{Binding ShowsSize, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size, StringFormat='{}{0:0} см'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SizeTitle}" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="300" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Size}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowsRotation, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Rotation, StringFormat='{}{0:0}°'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Поворот" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="-180" Maximum="180" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Rotation}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource ChipButton}" Content="↺ 90°" Command="{Binding RotateByCommand}" CommandParameter="-90"/>
                                        <Button Style="{StaticResource ChipButton}" Content="↻ 90°" Command="{Binding RotateByCommand}" CommandParameter="90"/>
                                        <Button Style="{StaticResource ChipButton}" Content="↻ 15°" Command="{Binding RotateByCommand}" CommandParameter="15"/>
                                    </StackPanel>
                                </StackPanel>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsReversed}" Margin="0,14,0,0"
                                          Visibility="{Binding ShowsReverse, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Первый светодиод на другом конце"/>
                                </CheckBox>

                                <StackPanel Visibility="{Binding IsPanel, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HexSize, StringFormat='{}{0:0.#} см'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Размер шестигранника" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="3" Maximum="40" Value="{Binding HexSize}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowsHexCount, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HexCount}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Шестигранников" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="1" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding HexCount}"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowsShapeEditor, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <TextBlock Text="Форма панели" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <Border CornerRadius="10" Background="#14FFFFFF" Padding="6">
                                        <controls:HexShapeEditor Item="{Binding}" Height="200"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Щелчок по пустой клетке добавляет шестигранник, по закрашенной — убирает. Соберите форму так, как панели висят на стене."/>
                                    <Button Style="{StaticResource ChipButton}" Content="Сбросить в соты" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Command="{Binding ResetShapeCommand}"
                                            Visibility="{Binding IsCustomShape, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Visibility="{Binding IsMonitor, Converter={StaticResource BoolToVisibility}}"
                                           Text="Ленту подсветки монитора, её раскладку и поворот монитора настраивайте в разделе «Мониторы» — на схеме они появятся сами."/>

                                <Button Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                        Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="-8,14,0,0" Padding="8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Убрать со сцены"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Что ещё можно поставить на сцену -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Добавить на сцену" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Всё уже на сцене. Новые ленты появятся здесь после поиска."
                                       Visibility="{Binding HasCandidates, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Candidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="-8,0,-8,2"
                                                Foreground="{StaticResource TextBrush}" ToolTip="Поставить на сцену"
                                                Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"
                                                           Foreground="{StaticResource AccentHoverBrush}"/>
                                                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource ControlBrush}">
                                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Слои: свои эффекты в своих областях поверх эффекта всей сцены -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right" Command="{Binding AddLayerCommand}" Style="{StaticResource GhostButton}"
                                        Padding="8,6" Margin="0,0,-8,0" ToolTip="Добавить слой с эффектом, выбранным в галерее">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Слой"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Слои эффектов" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Свой эффект в своей области поверх эффекта сцены. Слои играют вместе с ним — запустите эффект сцены или предпросмотр. Слой ниже в списке перекрывает те, что выше."/>

                            <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" HorizontalContentAlignment="Stretch"
                                     Margin="-8,0,-8,0" Visibility="{Binding HasLayers, Converter={StaticResource BoolToVisibility}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,4" ToolTip="Убрать слой"
                                                    Command="{Binding DataContext.RemoveLayerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </Button>
                                            <TextBlock Text="&#xE81E;" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Настройки выбранного слоя -->
                            <StackPanel Visibility="{Binding HasSelectedLayer, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                <StackPanel DataContext="{Binding SelectedLayer}">
                                    <TextBlock Text="Эффект слоя" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                    <!-- Колонка узкая — плитки по две в ряд -->
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Effect}" Style="{StaticResource EffectGallery}"/>
                                    </ScrollViewer>

                                    <DockPanel Margin="0,12,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding X, StringFormat='{}{0:0} см'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Слева" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding X}"/>

                                    <DockPanel Margin="0,12,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Y, StringFormat='{}{0:0} см'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Сверху" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="240" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Y}"/>

                                    <DockPanel Margin="0,12,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Width, StringFormat='{}{0:0} см'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ширина" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Width}"/>

                                    <DockPanel Margin="0,12,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Height, StringFormat='{}{0:0} см'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Высота" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="240" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Height}"/>

                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Область слоя можно двигать мышью на схеме, а за белую точку в углу — растягивать. Настройки эффекта — в галерее ниже, они общие для слоя и сцены."/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ResponsivePanel>

            <!-- Эффекты на всю сцену: идут по реальным местам устройств -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Эффекты сцены" Style="{StaticResource CardTitle}" Margin="0,0,0,2"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                               Text="Волны, огонь и круги проходят через все устройства так, как они стоят на стене. Музыкальные эффекты расходятся от основного монитора."/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                <TextBlock Text="Яркость сцены" Style="{StaticResource Hint}"/>
                            </DockPanel>
                            <Slider Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Brightness}"/>
                        </StackPanel>
                    </Grid>
                    <views:EffectPanel DataContext="{Binding Effects}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
