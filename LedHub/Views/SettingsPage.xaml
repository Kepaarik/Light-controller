<UserControl x:Class="LedHub.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LedHub.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Внешний вид и поведение приложения" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Внешний вид" Style="{StaticResource CardTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseAcrylic}" IsEnabled="{Binding IsAcrylicSupported}">
                        <StackPanel>
                            <TextBlock Text="Прозрачное стекло"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Сквозь окно видно, что под ним, — размыто, как через матовое стекло. Выключите, чтобы окно было матовым (Mica): спокойнее и чуть экономнее."/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Warning}" Margin="0,10,0,0" Text="Стекло доступно в Windows 11 22H2 и новее; в этой системе окно тёмное."
                               Visibility="{Binding IsAcrylicSupported, Converter={StaticResource InverseBoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Тонированное стекло: пресет как отправная точка, дальше — ползунки -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Стекло" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Готовые варианты" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Glass.Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.Glass.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Swatch}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Transparency, StringFormat='{}{0:0} %'}" FontWeight="SemiBold"/>
                        <TextBlock Text="Прозрачность" Style="{StaticResource Hint}"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Glass.Transparency}"/>

                    <DockPanel Margin="0,14,0,6">
                        <Border DockPanel.Dock="Right" Width="16" Height="16" CornerRadius="8" Background="{Binding Glass.TintSwatch}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock Text="Оттенок тонировки" Style="{StaticResource Hint}"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="359" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Glass.TintHue}"/>

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.TintStrength, StringFormat='{}{0:0} %'}" FontWeight="SemiBold"/>
                        <TextBlock Text="Сила тонировки" Style="{StaticResource Hint}"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Glass.TintStrength}"/>

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Frost, StringFormat='{}{0:0} %'}" FontWeight="SemiBold"/>
                        <TextBlock Text="Плотность карточек" Style="{StaticResource Hint}"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Glass.Frost}"/>

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Shine, StringFormat='{}{0:0} %'}" FontWeight="SemiBold"/>
                        <TextBlock Text="Блик по краю" Style="{StaticResource Hint}"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Glass.Shine}"/>

                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Тонировка ложится поверх системного стекла: при выключенном «Прозрачном стекле» окно матовое, но цвет и блик всё равно меняются."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Главный монитор" Style="{StaticResource CardTitle}"/>
                    <ComboBox ItemsSource="{Binding MainMonitorOptions}" SelectedItem="{Binding SelectedMainMonitor}" DisplayMemberPath="Title"/>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="С него берут картинку эффекты «По картинке монитора», на нём ищется запущенная игра."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Эффекты" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Частота кадров" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding FramesPerSecond}"
                              ItemStringFormat="{}{0} кадров в секунду" HorizontalAlignment="Left" MinWidth="220"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Больше кадров — плавнее эффекты на клавиатуре по проводу, но выше нагрузка на процессор. Ленты по Bluetooth и Wi-Fi всё равно получают не больше 20 кадров в секунду."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Запуск" Style="{StaticResource CardTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScanOnStartup}">
                        <StackPanel>
                            <TextBlock Text="Искать ленты при запуске"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Bluetooth, Wi-Fi и USB проверяются сразу, как только открывается LedHub."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/LedHub.png" Width="56" Height="56"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LedHub" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Все ленты, мониторы и шестигранники — в одном месте" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Настройки хранятся в %AppData%\LedHub\config.json" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
