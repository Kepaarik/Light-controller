<UserControl x:Class="LedHub.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LedHub.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Внешний вид и поведение приложения" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Внешний вид" Style="{StaticResource CardTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseAcrylic}" IsEnabled="{Binding IsAcrylicSupported}">
                        <StackPanel>
                            <TextBlock Text="Прозрачное стекло"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Сквозь окно видно, что под ним, — размыто, как через матовое стекло. Выключите, чтобы окно было матовым (Mica): спокойнее и чуть экономнее."/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Warning}" Margin="0,10,0,0" Text="Стекло доступно в Windows 11 22H2 и новее; в этой системе окно тёмное."
                               Visibility="{Binding IsAcrylicSupported, Converter={StaticResource InverseBoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Запуск" Style="{StaticResource CardTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScanOnStartup}">
                        <StackPanel>
                            <TextBlock Text="Искать ленты при запуске"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Bluetooth, Wi-Fi и USB проверяются сразу, как только открывается LedHub."/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/LedHub.png" Width="56" Height="56"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LedHub" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Все ленты, мониторы и шестигранники — в одном месте" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Настройки хранятся в %AppData%\LedHub\config.json" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
